{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compmd.hakanserce.com/schema/sandbox-protocol.schema.json",
  "title": "The CompMD sandbox's frame protocol",
  "description": "The messages between a frame and its parent, the window that made it (docs/sandbox-protocol.md), version 1. `@compmd/render`'s frame protocol travels on the same port beside them. `host` carries a MessagePort in the message's ports, and `code` may carry a Blob, which JSON can't hold.",
  "oneOf": [{ "$ref": "#/$defs/toFrame" }, { "$ref": "#/$defs/fromFrame" }],
  "$defs": {
    "toFrame": {
      "description": "From a parent to its frame.",
      "oneOf": [
        { "$ref": "#/$defs/level" },
        { "$ref": "#/$defs/code" },
        { "$ref": "#/$defs/part" },
        { "$ref": "#/$defs/styles" },
        { "$ref": "#/$defs/scheme" },
        { "$ref": "#/$defs/host" },
        { "$ref": "#/$defs/ping" },
        { "$ref": "#/$defs/compile" },
        { "$ref": "#/$defs/observe" }
      ]
    },
    "fromFrame": {
      "description": "From a frame to its parent.",
      "oneOf": [
        { "$ref": "#/$defs/ready" },
        { "$ref": "#/$defs/loaded" },
        { "$ref": "#/$defs/set" },
        { "$ref": "#/$defs/error" },
        { "$ref": "#/$defs/link" },
        { "$ref": "#/$defs/rendered" },
        { "$ref": "#/$defs/size" },
        { "$ref": "#/$defs/pong" },
        { "$ref": "#/$defs/compiled" },
        { "$ref": "#/$defs/failed" },
        { "$ref": "#/$defs/observed" }
      ]
    },
    "componentLevel": { "description": "A component's trust level.", "enum": ["strict", "permissive", "trusted"] },
    "level": {
      "description": "The frame's level, first and once; for a permissive frame, the network directives of its second policy (connect-src, img-src, font-src, media-src), which it adds before anything else.",
      "type": "object",
      "properties": {
        "type": { "const": "level" },
        "level": { "enum": ["strict", "permissive"] },
        "policy": { "type": "string" }
      },
      "required": ["type", "level"],
      "additionalProperties": false
    },
    "code": {
      "description": "Each component with its level: compiled text with its binding, a built module's file as a Blob with its place, or a built module by its URL and its file's hash; text and Blobs with the library packs they import. One of a level above the frame's comes without code, and its uses show their fallbacks.",
      "type": "object",
      "properties": {
        "type": { "const": "code" },
        "components": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "level": { "$ref": "#/$defs/componentLevel" },
                  "binding": { "enum": ["react", "svelte", "plain"] },
                  "code": { "type": "string" },
                  "css": { "type": "string" },
                  "libraries": { "$ref": "#/$defs/libraries" }
                },
                "required": ["name", "level", "binding", "code"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "level": { "$ref": "#/$defs/componentLevel" },
                  "binding": { "const": "plain" },
                  "code": { "description": "The module's file, a Blob the host's page has checked, which JSON can't hold." },
                  "place": { "description": "The module's place, `pack@version/path`, by which a frame knows it has it already.", "type": "string" },
                  "libraries": { "$ref": "#/$defs/libraries" }
                },
                "required": ["name", "level", "binding", "code", "place"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "level": { "$ref": "#/$defs/componentLevel" },
                  "module": {
                    "type": "object",
                    "properties": { "url": { "type": "string" }, "integrity": { "type": "string" } },
                    "required": ["url", "integrity"],
                    "additionalProperties": false
                  }
                },
                "required": ["name", "level", "module"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": { "name": { "type": "string" }, "level": { "$ref": "#/$defs/componentLevel" } },
                "required": ["name", "level"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["type", "components"],
      "additionalProperties": false
    },
    "libraries": {
      "description": "The library packs code given as text or a Blob imports, by the name it imports each by (docs/sharing-library-packs.md).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "place": { "description": "The library's module's place, `pack@version/path`, by which a frame loads it once.", "type": "string" },
          "code": { "description": "The module's file, a Blob the host's page has checked, which JSON can't hold." },
          "libraries": { "$ref": "#/$defs/libraries" }
        },
        "required": ["place", "code"],
        "additionalProperties": false
      }
    },
    "part": {
      "description": "The use the frame renders, an expanded component node (conformance/compmd-tree.schema.json) with its slots, or a code block a code renderer renders, with its alt and code; and the document's inputs.",
      "type": "object",
      "properties": {
        "type": { "const": "part" },
        "part": {
          "type": "object",
          "properties": {
            "node": { "type": "object", "properties": { "type": { "enum": ["componentContainer", "componentLeaf", "componentInline", "code"] } }, "required": ["type"] },
            "inputs": { "type": "object" }
          },
          "required": ["node", "inputs"],
          "additionalProperties": false
        }
      },
      "required": ["type", "part"],
      "additionalProperties": false
    },
    "styles": {
      "description": "The host's stylesheets.",
      "type": "object",
      "properties": { "type": { "const": "styles" }, "urls": { "type": "array", "items": { "type": "string" } } },
      "required": ["type", "urls"],
      "additionalProperties": false
    },
    "scheme": {
      "description": "The colour scheme of the page around the frame, which the frame's document takes.",
      "type": "object",
      "properties": { "type": { "const": "scheme" }, "scheme": { "enum": ["light", "dark"] } },
      "required": ["type", "scheme"],
      "additionalProperties": false
    },
    "host": {
      "description": "A port for `host`, in the message's ports; only to a permissive frame of a pack given `host`.",
      "type": "object",
      "properties": { "type": { "const": "host" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "ping": {
      "description": "Answer with `pong`, or be stopped.",
      "type": "object",
      "properties": { "type": { "const": "ping" }, "n": { "type": "integer" } },
      "required": ["type", "n"],
      "additionalProperties": false
    },
    "compile": {
      "description": "A source for the compile frame to compile.",
      "type": "object",
      "properties": {
        "type": { "const": "compile" },
        "name": { "type": "string" },
        "language": { "enum": ["jsx", "tsx", "svelte", "js", "ts"] },
        "runtime": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["type", "name", "language", "code"],
      "additionalProperties": false
    },
    "ready": {
      "description": "The frame is listening, with the sandbox protocol's version.",
      "type": "object",
      "properties": { "type": { "const": "ready" }, "sandbox": { "type": "integer" } },
      "required": ["type", "sandbox"],
      "additionalProperties": false
    },
    "loaded": {
      "description": "The code last sent is loaded, or shows fallbacks.",
      "type": "object",
      "properties": { "type": { "const": "loaded" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "set": {
      "description": "A component set an input; the parent checks that one of the frame's uses binds a param to it.",
      "type": "object",
      "properties": { "type": { "const": "set" }, "input": { "type": "string" }, "value": {} },
      "required": ["type", "input", "value"],
      "additionalProperties": false
    },
    "error": {
      "description": "A component shows its fallback: missing, threw (W118), its code failed, or its level can't be held here (not-here).",
      "type": "object",
      "properties": {
        "type": { "const": "error" },
        "reason": { "enum": ["missing", "threw", "failed", "not-here"] },
        "component": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["type", "reason", "message"],
      "additionalProperties": false
    },
    "link": {
      "description": "A link was clicked; the host's page decides what opens, after showing the reader the URL.",
      "type": "object",
      "properties": { "type": { "const": "link" }, "url": { "type": "string" } },
      "required": ["type", "url"],
      "additionalProperties": false
    },
    "rendered": {
      "description": "The frame's last render is painted.",
      "type": "object",
      "properties": { "type": { "const": "rendered" }, "ms": { "type": "number" } },
      "required": ["type", "ms"],
      "additionalProperties": false
    },
    "size": {
      "description": "The frame's content's size, for its parent to set on the frame.",
      "type": "object",
      "properties": { "type": { "const": "size" }, "width": { "type": "number" }, "height": { "type": "number" } },
      "required": ["type", "width", "height"],
      "additionalProperties": false
    },
    "pong": {
      "description": "The answer to `ping`.",
      "type": "object",
      "properties": { "type": { "const": "pong" }, "n": { "type": "integer" } },
      "required": ["type", "n"],
      "additionalProperties": false
    },
    "compiled": {
      "description": "A compile's result: the module's text, and a Svelte component's CSS.",
      "type": "object",
      "properties": { "type": { "const": "compiled" }, "name": { "type": "string" }, "code": { "type": "string" }, "css": { "type": "string" } },
      "required": ["type", "name", "code"],
      "additionalProperties": false
    },
    "failed": {
      "description": "A source that didn't compile, with the compiler's message.",
      "type": "object",
      "properties": { "type": { "const": "failed" }, "name": { "type": "string" }, "message": { "type": "string" } },
      "required": ["type", "name", "message"],
      "additionalProperties": false
    },
    "observe": {
      "description": "Record what passes in the frame and report it in `observed`, asking the frame's own frames too; or stop.",
      "type": "object",
      "properties": { "type": { "const": "observe" }, "on": { "type": "boolean" } },
      "required": ["type", "on"],
      "additionalProperties": false
    },
    "observed": {
      "description": "What the frame's observer recorded since its last report, sent only after its parent asked. Code of the frame's level may have written it: its parent checks each event, drops what isn't one, and puts the frame's id in front of each event's frame.",
      "type": "object",
      "properties": { "type": { "const": "observed" }, "events": { "type": "array", "items": { "$ref": "#/$defs/observedEvent" } } },
      "required": ["type", "events"],
      "additionalProperties": false
    },
    "frameId": { "description": "A frame by its path from the window that recorded it: empty for that window itself, `2` for its second frame, `2/1` for that frame's first.", "type": "string", "pattern": "^([0-9]+(/[0-9]+)*)?$" },
    "observedEvent": {
      "description": "One thing a window's observer saw, at `at`, in milliseconds since the epoch.",
      "type": "object",
      "properties": { "frame": { "$ref": "#/$defs/frameId" }, "at": { "type": "number", "minimum": 0 } },
      "required": ["type", "frame", "at"],
      "oneOf": [
        {
          "description": "The window made a frame.",
          "properties": {
            "type": { "const": "frame" },
            "frame": true,
            "at": true,
            "level": { "enum": ["strict", "permissive"] },
            "renders": {
              "oneOf": [
                { "type": "object", "properties": { "kind": { "enum": ["page", "compile"] } }, "required": ["kind"], "additionalProperties": false },
                { "type": "object", "properties": { "kind": { "const": "use" }, "component": { "type": "string" } }, "required": ["kind", "component"], "additionalProperties": false }
              ]
            },
            "network": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["level", "renders"],
          "additionalProperties": false
        },
        {
          "description": "A frame went: removed, stopped when it hung, or of another protocol version.",
          "properties": { "type": { "const": "gone" }, "frame": true, "at": true, "why": { "enum": ["removed", "hung", "version"] } },
          "required": ["why"],
          "additionalProperties": false
        },
        {
          "description": "A copy of a message between the window and its frame, down to it or up from it; large values kept by their size.",
          "properties": { "type": { "const": "message" }, "frame": true, "at": true, "way": { "enum": ["down", "up"] }, "data": {} },
          "required": ["way", "data"],
          "additionalProperties": false
        },
        {
          "description": "A component mounted in the window, as its use `use`, in `ms`.",
          "properties": { "type": { "const": "mounted" }, "frame": true, "at": true, "use": { "type": "integer", "minimum": 0 }, "component": { "type": "string" }, "ms": { "type": "number", "minimum": 0 } },
          "required": ["use", "component", "ms"],
          "additionalProperties": false
        },
        {
          "description": "A use updated, in `ms`.",
          "properties": { "type": { "const": "updated" }, "frame": true, "at": true, "use": { "type": "integer", "minimum": 0 }, "ms": { "type": "number", "minimum": 0 } },
          "required": ["use", "ms"],
          "additionalProperties": false
        },
        {
          "description": "A use went.",
          "properties": { "type": { "const": "unmounted" }, "frame": true, "at": true, "use": { "type": "integer", "minimum": 0 } },
          "required": ["use"],
          "additionalProperties": false
        },
        {
          "description": "A component shows its fallback in the window.",
          "properties": {
            "type": { "const": "fallback" },
            "frame": true,
            "at": true,
            "component": { "type": "string" },
            "reason": { "enum": ["missing", "threw", "failed", "not-here"] },
            "message": { "type": "string" }
          },
          "required": ["component", "reason", "message"],
          "additionalProperties": false
        },
        {
          "description": "The window dropped a `set` of `input` from its frame: none of the frame's uses binds it.",
          "properties": { "type": { "const": "refused" }, "frame": true, "at": true, "input": { "type": "string" } },
          "required": ["input"],
          "additionalProperties": false
        },
        {
          "description": "The window dropped events it couldn't hold.",
          "properties": { "type": { "const": "dropped" }, "frame": true, "at": true, "count": { "type": "integer", "minimum": 0 } },
          "required": ["count"],
          "additionalProperties": false
        }
      ]
    }
  }
}
