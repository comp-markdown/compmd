{
  "name": "@compmd/sandbox",
  "version": "0.1.1",
  "description": "Runs CompMD components in a browser at the trust levels of the spec: strict and permissive frames, trusted code inline, so no host writes a sandbox policy itself.",
  "keywords": [
    "compmd",
    "markdown",
    "components",
    "sandbox",
    "iframe",
    "csp"
  ],
  "homepage": "https://compmd.hakanserce.com/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "sandbox"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "protocol.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./protocol.schema.json": "./protocol.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/frames.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@compmd/render": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@compmd/processor": "workspace:*",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "happy-dom": "21.0.3",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sucrase": "3.35.1",
    "svelte": "5.57.2",
    "temml": "0.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
