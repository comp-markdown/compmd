{
  "name": "@compmd/editor",
  "version": "0.1.0",
  "private": true,
  "description": "The CompMD editor: a text area and the rendered page beside it, updated as you type. A static site that works offline once loaded.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "libs": "node scripts/libs.ts",
    "dev": "pnpm libs && vite",
    "build": "pnpm libs && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output machine",
    "test": "vitest run",
    "bench": "pnpm build && node bench/run.ts"
  },
  "dependencies": {
    "@compmd/processor": "workspace:*",
    "@compmd/render": "workspace:*",
    "d3": "7.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sucrase": "3.35.1",
    "svelte": "5.57.2",
    "temml": "0.14.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "happy-dom": "21.0.3",
    "playwright-core": "1.64.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
