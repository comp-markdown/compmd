{
  "name": "@compmd/create-pack",
  "version": "0.6.0",
  "description": "Writes a CompMD pack: a component as one built module, its signature, a test page in the sandbox, and the steps to publish it. npm create @compmd/pack <folder>",
  "keywords": [
    "compmd",
    "markdown",
    "components",
    "create",
    "template",
    "pack"
  ],
  "homepage": "https://compmd.hakanserce.com/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "create-pack"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-pack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "exports": {
    ".": {
      "types": "./dist/create.d.ts",
      "default": "./dist/create.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@compmd/pack": "workspace:*",
    "@compmd/sandbox": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "happy-dom": "21.0.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
