+/* A code block in its frame (`@compmd/render`'s, and the spec's and guides' from the build): a bar on the desk naming
+   its language and its lines, with Copy, over the code, numbered, on a tint between the desk and the sheet, held at
+   about twelve lines. In a `render=both` block the frame is the box's top, its code folded until the reader shows it,
+   and the output tagged in its corner. */
+.compmd-code,
+.compmd-both {
+  --code-tint: color-mix(in srgb, var(--desk) 50%, var(--sheet));
+  margin-block: 1.2em;
+  border: 1px solid var(--rule);
+  border-radius: var(--radius);
+  overflow: hidden;
+}
+
+.compmd-both {
+  --compmd-both-gap: 0;
+}
+
+.compmd-both > .compmd-code {
+  margin: 0;
+  border: 0;
+  border-block-end: 1px solid var(--rule);
+  border-radius: 0;
+}
+
+.compmd-code-bar {
+  min-block-size: 2.1rem;
+  padding: 3px 6px 3px 14px;
+  background: var(--desk);
+  color: var(--ink-secondary);
+  font: 0.78rem var(--sans);
+}
+
+.compmd-code-bar::before {
+  font-family: var(--mono);
+  font-weight: 600;
+}
+
+.compmd-code-bar:not([data-language=""])::after {
+  content: "·\2002" attr(data-lines);
+}
+
+.compmd-code-bar button {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35em;
+  padding: 3px 8px;
+  border: 1px solid transparent;
+  border-radius: 4px;
+  background: none;
+  color: var(--accent);
+  font: 600 0.78rem var(--sans);
+  cursor: pointer;
+}
+
+.compmd-code-bar button:hover {
+  border-color: var(--rule);
+  background: var(--sheet);
+}
+
+.compmd-code-bar .compmd-code-copy {
+  color: var(--ink-secondary);
+}
+
+.compmd-code-toggle::after {
+  content: "▸";
+  order: -1;
+  transition: transform 0.15s;
+}
+
+.compmd-code-toggle[aria-expanded="true"]::after {
+  transform: rotate(90deg);
+}
+
+@media (prefers-reduced-motion: reduce) {
