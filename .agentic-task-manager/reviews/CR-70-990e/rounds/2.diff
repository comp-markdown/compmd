+  font-size: 0.86rem;
+  line-height: 1.6;
+  overscroll-behavior: contain;
+  overflow: auto;
+  counter-reset: line;
+}
+
+/* Each line numbered: the renderer's lines, and Shiki's in a page written ahead. Not part of the text: a reader copies
