@@ -0,0 +1,97 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { FOLDED, FoldedCode } from "./folded-code.ts";
+
+let box: HTMLElement;
+let code: HTMLElement;
+beforeEach(() => {
+  box = document.body.appendChild(document.createElement("div"));
+  code = box.appendChild(document.createElement("pre"));
+  code.textContent = "A --> B\nB --> C";
+  box.appendChild(document.createElement("div")).textContent = "drawn";
+});
+afterEach(() => {
+  box.remove();
+  Reflect.deleteProperty(navigator, "clipboard");
+  document.getSelection()?.removeAllRanges();
+});
+
+/** Gives the page's navigator `value` as its clipboard. */
+function clipboard(value: Pick<Clipboard, "writeText"> | undefined): void {
+  Object.defineProperty(navigator, "clipboard", { value, configurable: true });
+}
+
+const toggle = () => box.querySelector<HTMLButtonElement>(".compmd-both-toggle");
+const copy = () => box.querySelector<HTMLButtonElement>(".compmd-both-copy");
+
+describe("a both box's folded code", () => {
+  it("puts a bar naming the code before it and the output's tag after it, folded", () => {
+    const folded = new FoldedCode(box, code);
+    folded.show("mermaid", "A --> B\nB --> C");
+    expect([...box.children].map((child) => child.className || child.nodeName)).toEqual(["compmd-both-bar", "PRE", "compmd-both-tag", "DIV"]);
+    expect(box.querySelector(".compmd-both-language")?.textContent).toBe("mermaid");
+    expect(box.querySelector(".compmd-both-lines")?.textContent).toBe("2 lines");
+    expect(box.querySelector(".compmd-both-tag")?.textContent).toBe("Output");
+    expect(folded.folded).toBe(true);
+    expect(box.classList.contains(FOLDED)).toBe(true);
+    expect(toggle()?.textContent).toBe("Show code");
+    expect(toggle()?.getAttribute("aria-expanded")).toBe("false");
+    expect(toggle()?.getAttribute("aria-controls")).toBe(code.id);
+    expect(code.id).toMatch(/^compmd-code-\d+$/);
+  });
+
+  it("shows the code on a click, and folds it again on the next", () => {
+    const folded = new FoldedCode(box, code);
+    toggle()?.click();
+    expect(folded.folded).toBe(false);
+    expect(toggle()?.textContent).toBe("Hide code");
+    expect(toggle()?.getAttribute("aria-expanded")).toBe("true");
+    toggle()?.click();
+    expect(folded.folded).toBe(true);
+  });
+
+  it("counts a line, and follows the code as it changes", () => {
+    const folded = new FoldedCode(box, code);
+    folded.show("compmd", "One line.");
+    expect(box.querySelector(".compmd-both-lines")?.textContent).toBe("1 line");
+    folded.show("compmd", "One.\nTwo.\nThree.");
+    expect(box.querySelector(".compmd-both-lines")?.textContent).toBe("3 lines");
+  });
+
+  it("keeps an id the code block has", () => {
+    code.id = "mine";
+    new FoldedCode(box, code);
+    expect(toggle()?.getAttribute("aria-controls")).toBe("mine");
+  });
+
+  it("copies the code it was shown, and says so", async () => {
+    const writeText = vi.fn(() => Promise.resolve());
+    clipboard({ writeText });
+    vi.useFakeTimers();
+    new FoldedCode(box, code).show("mermaid", "A --> B\nB --> C");
+    copy()?.click();
+    await vi.waitFor(() => {
+      expect(copy()?.textContent).toBe("Copied");
+    });
+    expect(writeText).toHaveBeenCalledWith("A --> B\nB --> C");
+    vi.advanceTimersByTime(1500);
+    expect(copy()?.textContent).toBe("Copy");
+    vi.useRealTimers();
+  });
+
+  it("selects the code for the reader to copy where the page may not write the clipboard", async () => {
+    clipboard({ writeText: () => Promise.reject(new Error("refused")) });
+    new FoldedCode(box, code).show("mermaid", "A --> B\nB --> C");
+    copy()?.click();
+    await vi.waitFor(() => {
+      expect(document.getSelection()?.toString()).toBe("A --> B\nB --> C");
+    });
+    expect(copy()?.textContent).toBe("Copy");
+  });
+
+  it("selects the code where the page has no clipboard", () => {
+    clipboard(undefined);
+    new FoldedCode(box, code).show("mermaid", "A --> B\nB --> C");
+    copy()?.click();
+    expect(document.getSelection()?.toString()).toBe("A --> B\nB --> C");
+  });
+});
diff --git a/npm-packages/render/src/folded-code.ts b/npm-packages/render/src/folded-code.ts
new file mode 100644
index 0000000..07ad195
--- /dev/null
+++ b/npm-packages/render/src/folded-code.ts
@@ -0,0 +1,102 @@
+// A `render=both` block's code, folded on screen until the reader asks for it (spec §7.7): a bar over the output names
+// the code (its language, its line count) with a button that shows it and one that copies it, and a tag names the
+// output while the code shows. On paper the code prints, then the output, and the bar and the tag don't.
+import { lineCount } from "./code-lines.ts";
+
+/** The class of a `both` box whose code is folded. */
+export const FOLDED = "compmd-folded";
+
+let made = 0;
+
+/**
+ * The bar and the tag of the `both` box `box`, around its code block `code`, which it folds.
+ *
+ * @example
+ * const folded = new FoldedCode(box, pre);
+ * folded.show("mermaid", "A --> B"); // the bar reads "mermaid · 1 line"
+ */
+export class FoldedCode {
+  readonly #box: HTMLElement;
+  readonly #code: HTMLElement;
+  readonly #language: HTMLElement;
+  readonly #lines: HTMLElement;
+  readonly #copy: HTMLButtonElement;
+  readonly #toggle: HTMLButtonElement;
+  readonly #tag: HTMLElement;
+  #text = "";
+
+  /** Puts the bar before `code` in `box` and the tag after it, and folds the code. */
+  constructor(box: HTMLElement, code: HTMLElement) {
+    const document = box.ownerDocument;
+    this.#box = box;
+    this.#code = code;
+    code.id ||= `compmd-code-${String(++made)}`;
+    const bar = document.createElement("div");
+    bar.className = "compmd-both-bar";
+    this.#language = bar.appendChild(document.createElement("span"));
+    this.#language.className = "compmd-both-language";
+    this.#lines = bar.appendChild(document.createElement("span"));
+    this.#lines.className = "compmd-both-lines";
+    this.#copy = bar.appendChild(button(document, "compmd-both-copy", "Copy"));
+    this.#copy.addEventListener("click", () => {
+      this.#copyCode();
+    });
+    this.#toggle = bar.appendChild(button(document, "compmd-both-toggle", ""));
+    this.#toggle.setAttribute("aria-controls", code.id);
+    this.#toggle.addEventListener("click", () => {
+      this.#fold(!this.folded);
+    });
+    this.#tag = document.createElement("div");
+    this.#tag.className = "compmd-both-tag";
+    this.#tag.appendChild(document.createElement("span")).textContent = "Output";
+    code.before(bar);
+    code.after(this.#tag);
+    this.#fold(true);
+  }
+
+  /** Whether the code is folded. */
+  get folded(): boolean {
+    return this.#box.classList.contains(FOLDED);
+  }
+
+  /** Names the code, in `language`, with `text`, which Copy copies. */
+  show(language: string, text: string): void {
+    this.#text = text;
+    if (this.#language.textContent !== language) this.#language.textContent = language;
+    const lines = lineCount(text);
+    const count = lines === 1 ? "1 line" : `${String(lines)} lines`;
+    if (this.#lines.textContent !== count) this.#lines.textContent = count;
+  }
+
+  #fold(folded: boolean): void {
+    this.#box.classList.toggle(FOLDED, folded);
+    this.#toggle.setAttribute("aria-expanded", String(!folded));
+    this.#toggle.textContent = folded ? "Show code" : "Hide code";
+  }
+
+  /** Copies the code; where the page may not write the clipboard, selects it, for the reader to copy. */
+  #copyCode(): void {
+    const clipboard = this.#box.ownerDocument.defaultView?.navigator.clipboard;
+    const select = () => {
+      this.#box.ownerDocument.getSelection()?.selectAllChildren(this.#code);
+    };
+    if (!clipboard) {
+      select();
+      return;
+    }
+    clipboard.writeText(this.#text).then(() => {
+      this.#copy.textContent = "Copied";
+      setTimeout(() => {
+        this.#copy.textContent = "Copy";
+      }, 1500);
+    }, select);
+  }
+}
+
+function button(document: Document, className: string, text: string): HTMLButtonElement {
+  const element = document.createElement("button");
+  element.type = "button";
+  element.className = className;
+  element.textContent = text;
+  return element;
+}
