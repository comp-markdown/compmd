@@ -0,0 +1,47 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { afterAwake, AWAKE_TICK_MS } from "./awake.ts";
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+/** Keeps this thread busy for `ms`, as a long task does. */
+function busyFor(ms: number): void {
+  const until = Date.now() + ms;
+  while (Date.now() < until);
+}
+
+const pause = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+describe("afterAwake", () => {
+  it("is done once the thread has been awake that long, and not a tick before", () => {
+    vi.useFakeTimers({ toFake: ["setInterval", "clearInterval"] });
+    const done = vi.fn();
+    afterAwake(1000, done);
+    vi.advanceTimersByTime(1000 - AWAKE_TICK_MS);
+    expect(done).not.toHaveBeenCalled();
+    vi.advanceTimersByTime(AWAKE_TICK_MS);
+    expect(done).toHaveBeenCalledTimes(1);
+    vi.advanceTimersByTime(5000);
+    expect(done).toHaveBeenCalledTimes(1);
+  });
+
+  it("is never done once cancelled", () => {
+    vi.useFakeTimers({ toFake: ["setInterval", "clearInterval"] });
+    const done = vi.fn();
+    afterAwake(1000, done)();
+    vi.advanceTimersByTime(5000);
+    expect(done).not.toHaveBeenCalled();
+  });
+
+  it("counts a stretch the thread was busy for as one tick, however long", async () => {
+    const done = vi.fn();
+    afterAwake(3 * AWAKE_TICK_MS, done);
+    // Twice the time it is given, by the clock: a timer of that time would be done on the thread's next turn.
+    busyFor(6 * AWAKE_TICK_MS);
+    await pause(AWAKE_TICK_MS / 5);
+    expect(done).not.toHaveBeenCalled();
+    await pause(4 * AWAKE_TICK_MS);
+    expect(done).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/npm-packages/sandbox/src/protocol/awake.ts b/npm-packages/sandbox/src/protocol/awake.ts
new file mode 100644
index 0000000..773c618
--- /dev/null
+++ b/npm-packages/sandbox/src/protocol/awake.ts
@@ -0,0 +1,27 @@
+// Time a frame is given, counted only while this window's thread answers. A page and its frames may share one thread
+// (WebKit, and Chromium's frames in the page's process): while it is busy, with another frame's module say, a frame
+// can neither load nor answer, and a clock's time would count against it. A tick that comes late counts as one tick.
+
+/** How often the awake time is counted, in ms: what a busy stretch of any length counts as, at most. */
+export const AWAKE_TICK_MS = 250;
+
+/**
+ * Calls `done` once this thread has been awake for `ms`, counted in ticks of `AWAKE_TICK_MS`: a stretch the thread was
+ * busy for counts as one tick, however long. Returns what cancels it.
+ *
+ * @example
+ * const cancel = afterAwake(5000, () => stop({ reason: "unloaded" }));
+ * port.addEventListener("message", cancel);
+ */
+export function afterAwake(ms: number, done: () => void): () => void {
+  let awake = 0;
+  const ticks = setInterval(() => {
+    awake += AWAKE_TICK_MS;
+    if (awake < ms) return;
+    clearInterval(ticks);
+    done();
+  }, AWAKE_TICK_MS);
+  return () => {
+    clearInterval(ticks);
+  };
+}
