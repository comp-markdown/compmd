index 0000000..561d6e8
--- /dev/null
+++ b/npm-packages/sandbox/src/sent-nodes.test.ts
@@ -0,0 +1,36 @@
+import type { ExpandedNode, Splice } from "@compmd/render";
+import { describe, expect, it } from "vitest";
+import { SentNodes } from "./sent-nodes.ts";
+
+const word = (value: string): ExpandedNode => ({ type: "text", value });
+/** The texts of `nodes`: the keys of this test. */
+const words = (nodes: readonly ExpandedNode[]): string[] => nodes.flatMap((node) => (node.type === "text" ? [String(node.value)] : []));
+const splice = (...nodes: ExpandedNode[]): Splice => ({ from: 0, to: 0, nodes, lines: 0, offset: 0 });
+
+describe("SentNodes", () => {
+  it("has the keys of the last tree sent, and not those of the tree before", () => {
+    const sent = new SentNodes(words);
+    sent.rendered([word("a"), word("b")]);
+    expect(sent.has("a")).toBe(true);
+    sent.rendered([word("c")]);
+    expect(sent.has("a")).toBe(false);
+    expect(sent.has("c")).toBe(true);
+  });
+
+  it("adds the keys of splices, those given as JSON text read only when asked", () => {
+    const sent = new SentNodes(words);
+    sent.rendered([word("a")]);
+    sent.spliced([splice(word("b")), JSON.stringify(splice(word("c")))]);
+    expect(sent.has("b")).toBe(true);
+    expect(sent.has("c")).toBe(true);
+    expect(sent.some((key) => key.startsWith("c"))).toBe(true);
+    expect(sent.some((key) => key === "d")).toBe(false);
+  });
+
+  it("drops splices not yet read when a new tree comes", () => {
+    const sent = new SentNodes(words);
+    sent.spliced([JSON.stringify(splice(word("old")))]);
+    sent.rendered([word("new")]);
+    expect(sent.has("old")).toBe(false);
+  });
+});
diff --git a/npm-packages/sandbox/src/sent-nodes.ts b/npm-packages/sandbox/src/sent-nodes.ts
new file mode 100644
index 0000000..62c45d9
--- /dev/null
+++ b/npm-packages/sandbox/src/sent-nodes.ts
@@ -0,0 +1,60 @@
+// What a parent sent a frame, as the keys a frame may ask about: an image's `src`, a code block's text and language.
+// Code in the frame could ask too, so the parent answers only for what it sent (docs/remote-images.md,
+// docs/host-highlighter.md, decision 4).
+
+import type { ExpandedNode, Splice } from "@compmd/render";
+
+/**
+ * The keys of the trees and splices a parent sent its frame, by `keysOf`.
+ *
+ * @example
+ * const sources = new SentNodes((nodes) => imageSources(nodes));
+ * sources.rendered(tree.children);
+ * sources.has("./logo.png"); // true
+ */
+export class SentNodes<K> {
+  readonly #keysOf: (nodes: readonly ExpandedNode[]) => Iterable<K>;
+  #keys = new Set<K>();
+  /** Splices as a processor's JSON text, read only once the frame asks about something they may have. */
+  #unread: string[] = [];
+
+  constructor(keysOf: (nodes: readonly ExpandedNode[]) => Iterable<K>) {
+    this.#keysOf = keysOf;
+  }
+
+  /** The frame renders `nodes`, in place of all it had. */
+  rendered(nodes: readonly ExpandedNode[]): void {
+    this.#keys = new Set(this.#keysOf(nodes));
+    this.#unread = [];
+  }
+
+  /** The frame applies `splices`, beside what it had. */
+  spliced(splices: readonly (Splice | string)[]): void {
+    for (const splice of splices) {
+      if (typeof splice === "string") this.#unread.push(splice);
+      else this.#add(splice.nodes);
+    }
+  }
+
+  /** Whether `key` is in what was sent. */
+  has(key: K): boolean {
+    if (this.#keys.has(key)) return true;
+    this.#readSplices();
+    return this.#keys.has(key);
+  }
+
+  /** Whether a key of what was sent is one `matches` takes. */
+  some(matches: (key: K) => boolean): boolean {
+    this.#readSplices();
+    return [...this.#keys].some(matches);
+  }
+
+  #readSplices(): void {
+    for (const splice of this.#unread) this.#add((JSON.parse(splice) as Splice).nodes);
+    this.#unread = [];
+  }
+
+  #add(nodes: readonly ExpandedNode[]): void {
+    for (const key of this.#keysOf(nodes)) this.#keys.add(key);
+  }
+}
