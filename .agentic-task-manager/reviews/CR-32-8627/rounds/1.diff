+import assert from "node:assert/strict";
+import { describe as suite, it } from "node:test";
+import { describe, stagedPacks, waiting } from "./staged.ts";
+
+const ITEMS = [
+  { id: "c", packageName: "@comp-markdown/chart", version: "0.1.0", status: "pending", createdAt: "2026-11-20T21:05:00Z" },
+  { id: "x", packageName: "@compmd/render", version: "0.10.0", createdAt: "2026-11-20T20:00:00Z" },
+  { id: "a", packageName: "@comp-markdown/card", version: "0.2.0", createdAt: "2026-11-20T21:04:00Z" },
+  { id: "m", packageName: "@comp-markdown/mermaid", version: "0.1.3", status: "approved", createdAt: "2026-11-19T10:00:00Z" },
+  { packageName: "@comp-markdown/broken", version: "1.0.0" },
+];
+
+suite("what npm has staged of the packs", () => {
+  it("is the packs' versions, oldest first, the others' and anything without an id left out", () => {
+    assert.deepEqual(
+      stagedPacks(JSON.stringify(ITEMS)).map((item) => item.id),
+      ["m", "a", "c"],
+    );
+  });
+
+  it("fails on anything but a list", () => {
+    assert.throws(() => stagedPacks('{"error": "E401"}'), /gave no list/);
+  });
+
+  it("waits for the author unless its status says it is settled", () => {
+    const [mermaid, card, chart] = stagedPacks(JSON.stringify(ITEMS));
+    assert.deepEqual([mermaid, card, chart].map((item) => item && waiting(item)), [false, true, true]);
+    for (const status of ["rejected", "Published", "APPROVED"]) assert.equal(waiting({ id: "i", packageName: "p", version: "1.0.0", status }), false, status);
+  });
+
+  it("is shown with its package, version and when it was staged, and a settled one's status", () => {
+    const [mermaid, card] = stagedPacks(JSON.stringify(ITEMS));
+    assert.equal(card && describe(card), "@comp-markdown/card 0.2.0, staged 2026-11-20 21:04");
+    assert.equal(mermaid && describe(mermaid), "@comp-markdown/mermaid 0.1.3, staged 2026-11-19 10:00 (approved)");
+  });
+});
diff --git a/tools/packs/staged.ts b/tools/packs/staged.ts
new file mode 100644
index 0000000..bb7e329
--- /dev/null
+++ b/tools/packs/staged.ts
@@ -0,0 +1,44 @@
+// What npm has staged of the packs, as `npm stage list --json` gives it: the registry's items, whose fields npm's own
+// `npm stage list` prints (`id`, `packageName`, `version`, `status`, `tag`, `createdAt`, npm 11.21.1's
+// `lib/utils/key-values.js`).
+
+import { SCOPE } from "./placeholder.ts";
+
+/** A version staged on npm, waiting for the author. */
+export interface Staged {
+  /** The stage's id, which `npm stage approve` takes. */
+  id: string;
+  packageName: string;
+  version: string;
+  /** npm's state of it; its values aren't documented. */
+  status?: string;
+  createdAt?: string;
+}
+
+/** A status that says the version is settled already: approved, rejected or published. */
+const SETTLED = /approv|reject|publish/i;
+
+/**
+ * The packs' staged versions in `json`, `npm stage list --json`'s output, oldest first: the order they were staged
+ * in, which is the order to approve them in, so a pack is never on npm before one staged before it.
+ *
+ * @throws Error when `json` isn't a list of staged versions.
+ */
+export function stagedPacks(json: string): Staged[] {
+  const items = JSON.parse(json) as unknown;
+  if (!Array.isArray(items)) throw new Error("npm stage list --json gave no list");
+  return (items as Partial<Staged>[])
+    .filter((item): item is Staged => typeof item.id === "string" && typeof item.packageName === "string" && typeof item.version === "string")
+    .filter((item) => item.packageName.startsWith(`${SCOPE}/`))
+    .sort((a, b) => (a.createdAt ?? "").localeCompare(b.createdAt ?? ""));
+}
+
+/** Whether a staged version waits for the author, so the list starts with it chosen. */
+export const waiting = (item: Staged): boolean => item.status === undefined || !SETTLED.test(item.status);
+
+/** How the list shows a staged version: `@comp-markdown/card 0.1.0, staged 2026-11-20 21:04`. */
+export function describe(item: Staged): string {
+  const when = item.createdAt ? `, staged ${item.createdAt.slice(0, 16).replace("T", " ")}` : "";
+  const status = item.status && !waiting(item) ? ` (${item.status})` : "";
+  return `${item.packageName} ${item.version}${when}${status}`;
+}
