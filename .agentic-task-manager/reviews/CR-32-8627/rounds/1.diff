diff --git a/tools/packs/approve-packs.test.ts b/tools/packs/approve-packs.test.ts
new file mode 100644
index 0000000..e323ba3
--- /dev/null
+++ b/tools/packs/approve-packs.test.ts
@@ -0,0 +1,97 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { approveArgs, approvePacks, type Steps } from "./approve-packs.ts";
+import type { Staged } from "./staged.ts";
+
+const ITEMS = [
+  { id: "c", packageName: "@comp-markdown/chart", version: "0.1.0", createdAt: "2026-11-20T21:05:00Z" },
+  { id: "a", packageName: "@comp-markdown/card", version: "0.2.0", createdAt: "2026-11-20T21:04:00Z" },
+  { id: "m", packageName: "@comp-markdown/mermaid", version: "0.1.3", status: "approved", createdAt: "2026-11-19T10:00:00Z" },
+];
+
+/** Steps over `items`, the author choosing with `pick` (by default what starts chosen) and giving `code`. */
+function stubs(items: unknown[], options: { pick?: (offered: readonly Staged[], chosen: (item: Staged) => boolean) => Staged[]; code?: string } = {}) {
+  const done: string[] = [];
+  const log: string[] = [];
+  const offered: string[] = [];
+  const steps: Steps = {
+    list: () => JSON.stringify(items),
+    choose: (list, chosen) => {
+      offered.push(...list.map((item) => `${chosen(item) ? "[x]" : "[ ]"} ${item.id}`));
+      return Promise.resolve(options.pick ? options.pick(list, chosen) : list.filter(chosen));
+    },
+    code: () => {
+      done.push("code");
+      return Promise.resolve(options.code);
+    },
+    npm: (args) => {
+      done.push(args.join(" "));
+    },
+    log: (line) => {
+      log.push(line);
+    },
+  };
+  return { steps, done, log, offered };
+}
+
+describe("cargo make approve-packs", () => {
+  it("offers every staged pack oldest first, those waiting chosen, and approves the chosen ones with one code", async () => {
+    const { steps, done, offered } = stubs(ITEMS, { code: "123456" });
+    assert.equal(await approvePacks({ dryRun: false }, steps), 0);
+    assert.deepEqual(offered, ["[ ] m", "[x] a", "[x] c"]);
+    assert.deepEqual(done, ["code", "stage approve a --otp 123456", "stage approve c --otp 123456"]);
+  });
+
+  it("approves in the order they were staged, whatever order the choice comes back in", async () => {
+    const { steps, done } = stubs(ITEMS, { pick: (list) => [...list].reverse() });
+    await approvePacks({ dryRun: false }, steps);
+    assert.deepEqual(done, ["code", "stage approve m", "stage approve a", "stage approve c"]);
+  });
+
+  it("approves only what the author left chosen", async () => {
+    const { steps, done } = stubs(ITEMS, { pick: (list) => list.filter((item) => item.id === "c") });
+    await approvePacks({ dryRun: false }, steps);
+    assert.deepEqual(done, ["code", "stage approve c"]);
+  });
+
+  it("asks for no code and approves nothing when nothing is chosen", async () => {
+    const { steps, done, log } = stubs(ITEMS, { pick: () => [] });
+    assert.equal(await approvePacks({ dryRun: false }, steps), 0);
+    assert.deepEqual(done, []);
+    assert.deepEqual(log, ["nothing chosen: nothing approved"]);
+  });
+
+  it("leaves the code to npm when the author gives none", () => {
+    assert.deepEqual(approveArgs({ id: "a", packageName: "p", version: "1.0.0" }), ["stage", "approve", "a"]);
+  });
+
+  it("with --dry-run, lists them as it would offer them, and approves nothing", async () => {
+    const { steps, done, log, offered } = stubs(ITEMS);
+    assert.equal(await approvePacks({ dryRun: true }, steps), 0);
+    assert.deepEqual(done, []);
+    assert.deepEqual(offered, []);
+    assert.deepEqual(log, [
+      "staged, 3; would offer them all, these chosen:",
+      "  [ ] @comp-markdown/mermaid 0.1.3, staged 2026-11-19 10:00 (approved)",
+      "  [x] @comp-markdown/card 0.2.0, staged 2026-11-20 21:04",
+      "  [x] @comp-markdown/chart 0.1.0, staged 2026-11-20 21:05",
+    ]);
+  });
+
+  it("says so when nothing is staged", async () => {
+    const { steps, done, log } = stubs([{ id: "x", packageName: "@compmd/render", version: "0.10.0" }]);
+    assert.equal(await approvePacks({ dryRun: false }, steps), 0);
+    assert.deepEqual(done, []);
+    assert.deepEqual(log, ["npm has nothing staged for the packs"]);
+  });
+
+  it("stops at npm's failure, the versions before it approved", async () => {
+    const { steps, done } = stubs(ITEMS);
+    steps.npm = (args) => {
+      if (args.includes("c")) throw new Error("npm failed");
+      done.push(args.join(" "));
+    };
+    await assert.rejects(approvePacks({ dryRun: false }, steps), /npm failed/);
+    assert.deepEqual(done, ["code", "stage approve a"]);
+  });
+});
diff --git a/tools/packs/approve-packs.ts b/tools/packs/approve-packs.ts
new file mode 100644
index 0000000..bf966de
--- /dev/null
+++ b/tools/packs/approve-packs.ts
@@ -0,0 +1,90 @@
+// `cargo make approve-packs` (docs/releases.md, decision 8): what npm has staged of the packs, as checkboxes, every
+// version waiting for you chosen; Enter approves the chosen ones, in the order they were staged, with one one-time
+// code, which npm asks for again once it has expired. With `--dry-run` it lists them and approves nothing.
+//
+//   node tools/packs/approve-packs.ts [--dry-run]
+
+import { createInterface } from "node:readline/promises";
+import checkbox from "@inquirer/checkbox";
+import { readNpm, runNpm, type RunNpm } from "./npm.ts";
+import { describe, stagedPacks, waiting, type Staged } from "./staged.ts";
+
+/** What `approvePacks` does through: each a stub in its tests. */
+export interface Steps {
+  /** `npm stage list --json`'s output. */
+  list(): string;
+  /** The ones the author chooses among `items`, those with `chosen` checked at first. */
+  choose(items: readonly Staged[], chosen: (item: Staged) => boolean): Promise<Staged[]>;
+  /** The author's one-time code, or `undefined` to let npm ask (a security key, a browser). */
+  code(): Promise<string | undefined>;
+  npm: RunNpm;
+  log(line: string): void;
+}
+
+/**
+ * npm's arguments that approve a staged version, with the author's one-time code when there is one. npm uses the
+ * code while it is valid, and asks for a new one itself once it has expired.
+ */
+export const approveArgs = (item: Staged, code?: string): string[] => ["stage", "approve", item.id, ...(code ? ["--otp", code] : [])];
+
+/**
+ * Approves the staged versions the author chooses, oldest first.
+ *
+ * @returns The exit code: 0, also when nothing is staged or nothing chosen.
+ * @throws Error when npm fails, after the versions before it are approved.
+ */
+export async function approvePacks(options: { dryRun: boolean }, steps: Steps): Promise<number> {
+  const staged = stagedPacks(steps.list());
+  if (staged.length === 0) {
+    steps.log("npm has nothing staged for the packs");
+    return 0;
+  }
+  if (options.dryRun) {
+    steps.log(`staged, ${String(staged.length)}; would offer them all, these chosen:`);
+    for (const item of staged) steps.log(`  [${waiting(item) ? "x" : " "}] ${describe(item)}`);
+    return 0;
+  }
+  const chosen = await steps.choose(staged, waiting);
+  // In the order they were staged, whatever order the list gave them back in.
+  const approving = staged.filter((item) => chosen.includes(item));
+  if (approving.length === 0) {
+    steps.log("nothing chosen: nothing approved");
+    return 0;
+  }
+  const code = await steps.code();
+  for (const item of approving) {
+    steps.npm(approveArgs(item, code));
+    steps.log(`approved ${describe(item)}`);
+  }
+  return 0;
+}
+
+/** The steps as they run: the pinned npm, and the checkboxes in the terminal. */
+const realSteps: Steps = {
+  list: () => readNpm(["stage", "list", "--json"]),
+  choose: (items, chosen) =>
+    checkbox<Staged>({
+      message: "Approve, in the order they were staged (space toggles, a toggles all, Enter approves):",
+      choices: items.map((item) => ({ name: describe(item), value: item, checked: chosen(item) })),
+      pageSize: 20,
+    }),
+  async code() {
+    const terminal = createInterface({ input: process.stdin, output: process.stdout });
+    const answer = (await terminal.question("One-time code from your authenticator (Enter to let npm ask, for a security key): ")).trim();
+    terminal.close();
+    return answer === "" ? undefined : answer;
+  },
+  npm: runNpm,
+  log: (line) => {
+    console.log(line);
+  },
+};
+
+if (import.meta.main) {
+  try {
+    process.exitCode = await approvePacks({ dryRun: process.argv.includes("--dry-run") }, realSteps);
+  } catch (error) {
+    console.error(error instanceof Error ? error.message : String(error));
+    process.exitCode = 1;
+  }
+}
