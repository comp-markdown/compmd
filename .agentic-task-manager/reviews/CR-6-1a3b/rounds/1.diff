+import { afterEach, describe, expect, it } from "vitest";
+import { createPage, type Page } from "./page.ts";
+import type { ExpandedNode, Origin } from "./tree.ts";
+
+/** An origin from line `from` to line `to`, each at column 1, with no offsets. */
+const lines = (from: number, to: number): Origin => ({ start: { line: from, column: 1 }, end: { line: to, column: 1 }, occurrence: 0 });
+
+const code = (value: string, origin?: Origin): ExpandedNode => ({ type: "code", lang: "ts", meta: null, value, ...(origin ? { origin } : {}) });
+const paragraph = (value: string, origin: Origin): ExpandedNode => ({ type: "paragraph", children: [{ type: "text", value, origin }], origin });
+
+let root: HTMLElement;
+function page(): Page {
+  root = document.body.appendChild(document.createElement("main"));
+  return createPage(root);
+}
+afterEach(() => {
+  root.remove();
+});
+
+const lineElements = () => [...root.querySelectorAll("pre > code > .compmd-line")];
+
+describe("a code block's lines", () => {
+  it("are an element each, a blank line too, each with its line break, so the block's text is the code's", () => {
+    page().render({ type: "root", children: [code("let a;\n\nlet b;")] });
+    expect(root.innerHTML).toBe('<pre><code class="language-ts"><span class="compmd-line">let a;\n</span><span class="compmd-line">\n</span><span class="compmd-line">let b;</span></code></pre>');
+    expect(root.querySelector("code")?.textContent).toBe("let a;\n\nlet b;");
+  });
+
+  it("are numbered with their lines in the text: a fenced block's from the line after its fence", () => {
+    // "Intro.\n\n```ts\nconst a = 1;\nconst b = 2;\n```": the block from line 3 to line 6.
+    page().render({ type: "root", children: [paragraph("Intro.", lines(1, 1)), code("const a = 1;\nconst b = 2;", lines(3, 6))] });
+    expect(lineElements().map((line) => line.getAttribute("data-line"))).toEqual(["4", "5"]);
+  });
+
+  it("are numbered from the block's first line when it has no fence, as an indented block", () => {
+    page().render({ type: "root", children: [code("a\nb", lines(2, 3))] });
+    expect(lineElements().map((line) => line.getAttribute("data-line"))).toEqual(["2", "3"]);
+  });
+
+  it("are numbered again when a change before the block moves it, the same elements", () => {
+    const p = page();
+    p.render({ type: "root", children: [paragraph("Intro.", lines(1, 1)), code("const a = 1;\nconst b = 2;", lines(3, 6))] });
+    const [first] = lineElements();
+    // A line typed above the paragraph: the block, kept, is one line on.
+    p.splice([{ from: 0, to: 0, nodes: [paragraph("New line.", lines(1, 1))], lines: 1, offset: 10 }]);
+    expect(lineElements().map((line) => line.getAttribute("data-line"))).toEqual(["5", "6"]);
+    expect(lineElements()[0]).toBe(first);
+  });
+
+  it("have no numbers where the tree has no origins", () => {
+    page().render({ type: "root", children: [code("a\nb")] });
+    expect(lineElements().map((line) => line.hasAttribute("data-line"))).toEqual([false, false]);
+  });
+});
diff --git a/npm-packages/render/src/code-lines.ts b/npm-packages/render/src/code-lines.ts
new file mode 100644
index 0000000..1f47c20
--- /dev/null
+++ b/npm-packages/render/src/code-lines.ts
@@ -0,0 +1,56 @@
+// A code block's lines, each an element of its own, so a host can style one (a diff's two sides kept level, a line
+// marked): `<span class="compmd-line" data-line="N">`, N its line in the current text, its newline inside it, so the
+// block's text, and what a reader copies, are the code's. The renderer draws them, numbers them again when what is
+// before the block moves them, and a highlighter fills them with its tokens.
+import type { Placed } from "./source.ts";
+
+/** The class of a code block's line. */
+export const CODE_LINE = "compmd-line";
+
+/** How many lines `text` has: one more than its line breaks. */
+export const lineCount = (text: string): number => text.split("\n").length;
+
+/**
+ * `code`'s text, `text`, drawn in `code` as one line element per line: each line's text, then its line break but the
+ * last's. A blank line is an element with its line break alone.
+ */
+export function drawCodeLines(code: HTMLElement, text: string): void {
+  const document = code.ownerDocument;
+  const lines = text.split("\n");
+  code.replaceChildren(
+    ...lines.map((line, i) => {
+      const element = document.createElement("span");
+      element.className = CODE_LINE;
+      element.textContent = i < lines.length - 1 ? `${line}\n` : line;
+      return element;
+    }),
+  );
+}
+
+/**
+ * The `<code>` of a code block `placed` drew, with the line its code starts on: a fenced block's starts on the line
+ * after its fence, an indented one's on its first line. None for anything else, or for a kept render, an older
+ * text's, whose lines aren't the current text's.
+ */
+export function codeOf({ dom, source, node, kept }: Placed): { code: Element; first: number } | undefined {
+  if (kept || node.type !== "code" || dom.nodeName !== "PRE") return undefined;
+  const code = (dom as Element).firstElementChild;
+  if (!code) return undefined;
+  const { start, end } = source;
+  const fenced = end.line - start.line + 1 > lineCount(code.textContent);
+  return { code, first: start.line + (fenced ? 1 : 0) };
+}
+
+/** Numbers the lines of each code block in `placed` with their lines in the current text, `data-line`. */
+export function numberCodeLines(placed: Iterable<Placed>): void {
+  for (const each of placed) {
+    const found = codeOf(each);
+    if (!found) continue;
+    let line = found.first;
+    for (const child of found.code.children) {
+      if (!child.classList.contains(CODE_LINE)) continue;
+      const number = String(line++);
+      if (child.getAttribute("data-line") !== number) child.setAttribute("data-line", number);
+    }
+  }
+}
