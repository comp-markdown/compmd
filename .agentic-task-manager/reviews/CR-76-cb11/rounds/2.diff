+        if after_the_edit(self.position) {
+            if let Body::Compmd(body) = &mut self.body {
+                body.shift(moved.by);
+            }
+            self.position.shift(moved.by);
         }
-        self.fence.shift(by);
-        self.position.shift(by);
     }
 }
 
