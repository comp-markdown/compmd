+++ b/spikes/highlight-perf/src/highlighters.ts
@@ -0,0 +1,150 @@
+// The variants' highlighters, `@compmd/render`'s `CodeHighlighter`, each made of the choices the spike tries: where
+// Shiki lives (one per view, as the sandbox's host mode has it today, or one for the page), its engine, where it
+// tokenizes (the page's thread or a worker), when blocks are highlighted (each as it renders, or one per task with
+// those on screen first), and a cache of tokens. Every step is counted in `stats`.
+
+import type { CodeHighlighter } from "@compmd/render";
+import type { HighlighterCore } from "@shikijs/core";
+import { draw } from "./draw.ts";
+import { loadShiki, tokensOf, type Engine, type Lines } from "./shiki.ts";
+
+export interface Config {
+  shiki: "per-view" | "shared";
+  engine: Engine;
+  where: "main" | "worker";
+  schedule: "eager" | "sliced";
+  cache: boolean;
+}
+
+/** What the highlighting cost, on the page's thread unless named. */
+export const stats = {
+  /** Shiki made, and how long each took (in the worker, for `where: "worker"`). */
+  setups: [] as number[],
+  /** Each tokenizing, in order: the first ones carry the regexes' compiling. */
+  tokenize: [] as number[],
+  /** Drawing the tokens into the lines. */
+  draw: [] as number[],
+  cacheHits: 0,
+};
+
+type Tokenize = (code: string) => Promise<Lines>;
+
+/** Tokenizing on the page's thread, with one Shiki made by `shiki` the first time. */
+function onPage(engine: Engine): Tokenize {
+  let shiki: Promise<HighlighterCore> | undefined;
+  return async (code) => {
+    shiki ??= loadShiki(engine).then(({ shiki: made, ms }) => {
+      stats.setups.push(ms);
+      return made;
+    });
+    const loaded = await shiki;
+    const started = performance.now();
+    const lines = tokensOf(loaded, code);
+    stats.tokenize.push(performance.now() - started);
+    return lines;
+  };
+}
+
+/** Tokenizing in one worker for the page. */
+function inWorker(engine: Engine): Tokenize {
+  const worker = new Worker(new URL("./worker.ts", import.meta.url), { type: "module" });
+  const waiting = new Map<number, (lines: Lines) => void>();
+  let last = 0;
+  let setupCounted = false;
+  worker.addEventListener("message", (event: MessageEvent<{ id: number; lines: Lines; ms: number; setup: number }>) => {
+    const { id, lines, ms, setup } = event.data;
+    if (!setupCounted) {
+      stats.setups.push(setup);
+      setupCounted = true;
+    }
+    stats.tokenize.push(ms);
+    waiting.get(id)?.(lines);
+    waiting.delete(id);
+  });
+  return (code) =>
+    new Promise((resolve) => {
+      const id = ++last;
+      waiting.set(id, resolve);
+      worker.postMessage({ id, code, engine });
+    });
+}
+
+/** `tokenize` with its tokens kept by their text, for a block seen again. */
+function cached(tokenize: Tokenize): Tokenize {
+  const kept = new Map<string, Lines>();
+  return async (code) => {
+    const found = kept.get(code);
+    if (found) {
+      stats.cacheHits += 1;
+      return found;
+    }
+    const lines = await tokenize(code);
+    kept.set(code, lines);
+    return lines;
+  };
+}
+
+/** The next task, after the browser has had its turn: a message, which no timer clamps. */
+const nextTask = () =>
+  new Promise<void>((resolve) => {
+    const { port1, port2 } = new MessageChannel();
+    port1.onmessage = () => {
+      resolve();
+    };
+    port2.postMessage(null);
+  });
+
+const shows = (element: HTMLElement) => {
+  const { top, bottom } = element.getBoundingClientRect();
+  return bottom > 0 && top < innerHeight;
+};
+
+/**
+ * Makes each view's highlighter, as `config` says; `drawn` is told when a block's tokens are drawn. With `shiki:
+ * "per-view"` each call makes a Shiki of its own (a worker is the page's either way).
+ */
+export function highlighters(config: Config, drawn: (target: HTMLElement) => void): () => CodeHighlighter {
+  const make = (): Tokenize => {
+    const tokenize = config.where === "worker" ? inWorker(config.engine) : onPage(config.engine);
+    return config.cache ? cached(tokenize) : tokenize;
+  };
+  const shared = config.shiki === "shared" || config.where === "worker" ? make() : undefined;
+
+  const show = (lines: Lines, code: string, target: HTMLElement) => {
+    const started = performance.now();
+    if (draw(lines, code, target)) drawn(target);
+    stats.draw.push(performance.now() - started);
+  };
+
+  // Sliced: one block per task, those on screen first, across every view.
+  const queue: { code: string; target: HTMLElement; tokenize: Tokenize }[] = [];
+  let pumping = false;
+  const pump = async () => {
+    pumping = true;
+    while (queue.length > 0) {
+      await nextTask();
+      const at = Math.max(
+        0,
+        queue.findIndex((job) => shows(job.target)),
+      );
+      const [job] = queue.splice(at, 1);
+      if (!job) continue;
+      show(await job.tokenize(job.code), job.code, job.target);
+    }
+    pumping = false;
+  };
+
+  return () => {
+    const tokenize = shared ?? make();
+    return (code, _language, target) => {
+      if (config.schedule === "sliced") {
+        queue.push({ code, target, tokenize });
+        if (!pumping) void pump();
+        return;
+      }
+      void tokenize(code).then((lines) => {
+        show(lines, code, target);
+      });
+    };
+  };
+}
diff --git a/spikes/highlight-perf/src/main.ts b/spikes/highlight-perf/src/main.ts
new file mode 100644
index 0000000..52479f6
--- /dev/null
+++ b/spikes/highlight-perf/src/main.ts
@@ -0,0 +1,193 @@
+// The test page: hundreds of short TypeScript runs, each a page of its own (`createPage`), mounted when it comes
+// within a screen of view, as a diff viewer's list is. The variant is the URL's query (`highlighters.ts`). The page
+// records every animation frame, so the runner can read how long frames blocked in each phase: opening, a skim to the
+// end, and a revisit, every run mounted again, as a reader jumping back.
+
+import { createPage, type Page } from "@compmd/render";
+import { highlighters, stats, type Config } from "./highlighters.ts";
+import { runsOf } from "./runs.ts";
+
+const query = new URLSearchParams(location.search);
+const config: Config = {
+  shiki: query.get("shiki") === "shared" ? "shared" : "per-view",
+  engine: (query.get("engine") ?? "js") as Config["engine"],
+  where: query.get("where") === "worker" ? "worker" : "main",
+  schedule: query.get("schedule") === "sliced" ? "sliced" : "eager",
+  cache: query.get("cache") === "1",
+};
+const COUNT = Number(query.get("runs") ?? 440);
+
+/** Every animation frame's time, from the page's start. */
+const frames: number[] = [];
+const tick = (at: number) => {
+  frames.push(at);
+  requestAnimationFrame(tick);
+};
+requestAnimationFrame(tick);
+
+const scroller = document.querySelector<HTMLElement>("#scroller") ?? document.body;
+const runs = runsOf(COUNT);
+
+interface Run {
+  slot: HTMLElement;
+  page?: Page;
+  mounted?: number;
+  highlighted?: number;
+}
+const slots: Run[] = runs.map((code) => {
+  const slot = scroller.appendChild(document.createElement("div"));
+  slot.className = "run";
+  // About the run's height, so the list is as long before its runs mount.
+  slot.style.minHeight = `${String(code.split("\n").length * 18 + 8)}px`;
+  return { slot };
+});
+const bySlot = new Map(slots.map((run) => [run.slot, run]));
+
+const made = highlighters(config, (target) => {
+  const run = bySlot.get(target.closest<HTMLElement>(".run") ?? target);
+  if (run && run.highlighted === undefined) run.highlighted = performance.now();
+});
+
+/** A run's page, rendered: one code block, with its origin, as a document of one fenced block. */
+function mount(index: number): void {
+  const run = slots[index];
+  const code = runs[index];
+  if (!run || code === undefined || run.page) return;
+  run.mounted = performance.now();
+  delete run.highlighted;
+  run.page = createPage(run.slot, query.get("highlight") === "off" ? {} : { highlight: made() });
+  if (query.get("highlight") === "off") run.highlighted = performance.now();
+  const lines = code.split("\n").length;
+  run.page.render({ type: "root", children: [{ type: "code", lang: "ts", meta: null, value: code, origin: { start: { line: 1, column: 1 }, end: { line: lines + 2, column: 4 }, occurrence: 0 } }] });
+}
+
+/**
+ * A run's page gone, once it leaves the window around the screen, as a virtual list does: its slot keeps its height.
+ * Without `?keep=1`: kept mounted, hundreds of pages are each a stylesheet in the one document (see the README).
+ */
+function unmount(index: number): void {
+  const run = slots[index];
+  if (!run?.page || query.get("keep") === "1") return;
+  run.slot.style.minHeight = `${String(run.slot.offsetHeight)}px`;
+  run.page.destroy();
+  delete run.page;
+  run.slot.replaceChildren();
+}
+
+const observer = new IntersectionObserver(
+  (entries) => {
+    for (const entry of entries) {
+      const index = slots.findIndex((run) => run.slot === entry.target);
+      if (entry.isIntersecting) mount(index);
+      else unmount(index);
+    }
+  },
+  { root: scroller, rootMargin: "100% 0px" },
+);
+for (const run of slots) observer.observe(run.slot);
+
+const pause = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+/** Resolves once every mounted run is highlighted, or after `ms`. */
+async function idle(ms = 60_000): Promise<void> {
+  const until = performance.now() + ms;
+  while (performance.now() < until && slots.some((run) => run.page && run.highlighted === undefined)) await pause(20);
+}
+
+/** The frames of `[from, to]`: the time in frames over 50 ms past 50 ms, the longest, and how many were long. */
+function blocked(from: number, to: number) {
+  let time = 0;
+  let longest = 0;
+  let long = 0;
+  for (let i = 1; i < frames.length; i++) {
+    const [before, at] = [frames[i - 1] ?? 0, frames[i] ?? 0];
+    if (at < from || before > to) continue;
+    const gap = at - before;
+    longest = Math.max(longest, gap);
+    if (gap > 50) {
+      time += gap - 50;
+      long += 1;
+    }
+  }
+  return { blockedMs: Math.round(time), longestMs: Math.round(longest), longFrames: long };
+}
+
+const percentile = (values: number[], p: number) => {
+  const sorted = [...values].sort((a, b) => a - b);
+  return Math.round(sorted[Math.min(sorted.length - 1, Math.floor((sorted.length - 1) * p))] ?? 0);
+};
+
+/** From mounting to highlighted, of the runs mounted in `[from, to]`. */
+function waits(from: number, to: number) {
+  const all = slots.filter((run) => run.mounted !== undefined && run.mounted >= from && run.mounted <= to && run.highlighted !== undefined).map((run) => (run.highlighted ?? 0) - (run.mounted ?? 0));
+  return { runs: all.length, medianWaitMs: percentile(all, 0.5), p95WaitMs: percentile(all, 0.95) };
+}
+
+/** Scrolls to the end as a reader skims: a screen and a half every 100 ms. */
+async function skim(): Promise<void> {
+  while (scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1) {
+    scroller.scrollTop += scroller.clientHeight * 1.5;
+    await pause(100);
+  }
+}
+
+const sum = (values: number[]) => Math.round(values.reduce((total, value) => total + value, 0));
+
+/** The steps' costs so far, and since `mark`. */
+const costs = () => ({
+  setups: stats.setups.map(Math.round),
+  firstTokenizeMs: Math.round(stats.tokenize[0] ?? 0),
+  tokenizeMs: sum(stats.tokenize),
+  tokenized: stats.tokenize.length,
+  medianTokenizeMs: Number((stats.tokenize.length ? [...stats.tokenize].sort((a, b) => a - b)[Math.floor(stats.tokenize.length / 2)] ?? 0 : 0).toFixed(2)),
+  drawMs: sum(stats.draw),
+  cacheHits: stats.cacheHits,
+});
+
+declare global {
+  interface Window {
+    spike: { run(): Promise<unknown> };
+  }
+}
+
+window.spike = {
+  async run() {
+    const opened = performance.now();
+    // The first runs mount when the observer first reports, a frame or so after the page loads.
+    for (let tries = 0; tries < 250 && !slots.some((run) => run.page); tries++) await pause(20);
+    console.log(`opening: ${String(slots.filter((run) => run.page).length)} runs mounted`);
+    await idle();
+    console.log(`opened: ${String(slots.filter((run) => run.highlighted !== undefined).length)} highlighted`);
+    await pause(500);
+    const open = { ...blocked(0, performance.now()), ...waits(0, performance.now()), loadToHighlightedMs: Math.round(performance.now() - 500) };
+    const afterOpen = costs();
+
+    const skimStart = performance.now();
+    await skim();
+    console.log(`skimmed: ${String(slots.filter((run) => run.page).length)} mounted`);
+    await idle();
+    console.log(`skim idle: ${String(slots.filter((run) => run.highlighted !== undefined).length)} highlighted`);
+    await pause(500);
+    const skimEnd = performance.now();
+    const skimmed = { ...blocked(skimStart, skimEnd), ...waits(skimStart, skimEnd), toAllHighlightedMs: Math.round(skimEnd - 500 - skimStart) };
+    const afterSkim = costs();
+
+    // A reader jumping back: every run's page gone, then each mounted again as the list is skimmed once more.
+    for (const run of slots) {
+      run.page?.destroy();
+      delete run.page;
+      run.slot.replaceChildren();
+    }
+    scroller.scrollTop = 0;
+    await pause(300);
+    const revisitStart = performance.now();
+    await idle();
+    await skim();
+    await idle();
+    await pause(500);
+    const revisitEnd = performance.now();
+    const revisit = { ...blocked(revisitStart, revisitEnd), ...waits(revisitStart, revisitEnd) };
+
+    return { config, runs: runs.length, openedAtMs: Math.round(opened), open, skim: skimmed, revisit, costs: { afterOpen, afterSkim, total: costs() } };
+  },
+};
diff --git a/spikes/highlight-perf/src/runs.ts b/spikes/highlight-perf/src/runs.ts
new file mode 100644
index 0000000..e02b272
--- /dev/null
+++ b/spikes/highlight-perf/src/runs.ts
@@ -0,0 +1,24 @@
+// The page's runs: short pieces of the repository's own TypeScript, as a diff viewer shows a review's hunks, the same
+// every time, so each variant highlights the same text.
+
+const sources = import.meta.glob(["../../../npm-packages/*/src/**/*.ts", "!**/*.test.ts"], { query: "?raw", import: "default", eager: true }) as Record<string, string>;
+
+/** How many lines each run has, in turn: hunks of a few lines to a few dozen. */
+const LENGTHS = [6, 12, 20, 9, 30, 15, 4, 25];
+
+/** `count` runs of TypeScript, each a few lines to a few dozen. */
+export function runsOf(count: number): string[] {
+  const runs: string[] = [];
+  let turn = 0;
+  for (const path of Object.keys(sources).sort()) {
+    const lines = (sources[path] ?? "").split("\n");
+    for (let at = 0; at < lines.length && runs.length < count; ) {
+      const length = LENGTHS[turn++ % LENGTHS.length] ?? 10;
+      const run = lines.slice(at, at + length).join("\n").trimEnd();
+      at += length;
+      if (run.trim() !== "") runs.push(run);
+    }
+    if (runs.length === count) break;
+  }
+  return runs;
+}
