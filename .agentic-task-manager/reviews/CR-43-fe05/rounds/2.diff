new file mode 100644
index 0000000..72e859f
--- /dev/null
+++ b/npm-packages/pack/src/wrap/signature.ts
@@ -0,0 +1,38 @@
+// The generated signature fence (docs/wrapping-an-npm-package.md, decision 4; spec §7.3): the params in the short form,
+// `level: L | M | H | Q?` or `margin: number = 4`, and in the long form when one has a doc; the slots the overrides
+// name; and the box's defaults as the fence's param list (G8).
+
+import { stringify } from "yaml";
+import type { Wrap } from "./config.ts";
+import type { Param } from "./map.ts";
+
+/** A default as a param value (spec §3.1): bare when it can be, else quoted or JSON. */
+export function writtenValue(value: unknown): string {
+  if (typeof value === "string") return /^[^\s"'{}()[\]=,]+$/.test(value) ? value : JSON.stringify(value);
+  if (typeof value === "number" || typeof value === "boolean") return String(value);
+  return JSON.stringify(value);
+}
+
+/** `param` as its declaration: the short form's text, or the long form's mapping. */
+function declaration(param: Param): string | Record<string, unknown> {
+  const type = `${param.type}${param.optional && param.default === undefined ? "?" : ""}`;
+  if (param.doc === undefined) return param.default === undefined ? type : `${type} = ${writtenValue(param.default)}`;
+  return { type, ...(param.default === undefined ? {} : { default: param.default }), doc: param.doc };
+}
+
+/**
+ * The signature fence of the component `component` for `params`.
+ *
+ * @example
+ * signatureFence("qr-code", [{ name: "value", prop: "value", type: "string", optional: false }], wrap);
+ * // "```compmd component=qr-code signature\nparams:\n  value: string\n```"
+ */
+export function signatureFence(component: string, params: readonly Param[], wrap: Wrap): string {
+  const header = {
+    params: Object.fromEntries(params.map((param) => [param.name, declaration(param)])),
+    ...(wrap.slots === undefined ? {} : { slots: Object.keys(wrap.slots) }),
+  };
+  const yaml = stringify(header, { lineWidth: 0, flowCollectionPadding: false }).trimEnd();
+  const box = wrap.box === undefined || wrap.box.trim() === "" ? "" : ` {${wrap.box.trim()}}`;
+  return `\`\`\`compmd component=${component} signature${box}\n${yaml}\n\`\`\``;
+}
diff --git a/npm-packages/pack/test/wrapped.ts b/npm-packages/pack/test/wrapped.ts
new file mode 100644
index 0000000..1735def
--- /dev/null
+++ b/npm-packages/pack/test/wrapped.ts
@@ -0,0 +1,55 @@
+// Packages to wrap, as `npm install` puts them, with types of their own: a React component, a Svelte component, a
+// custom element and a plain library, and the few types of React and Svelte their props read. For the tests of the
+// wrap (docs/wrapping-an-npm-package.md).
+
+/** React's types, as far as a component's props read them: its props, the DOM's own, and a CSS colour. */
+const REACT_TYPES = `export type ComponentProps<T> = T extends (props: infer P) => unknown ? P : never;
+export interface SVGProps<T> { className?: string; style?: object; width?: number; height?: number; onClick?: (event: T) => void }
+type Color = "red" | "blue" | (string & {});
+export interface CSSProperties { backgroundColor?: Color; color?: Color }
+`;
+
+/** Svelte's types, as far as a component's props read them. */
+const SVELTE_TYPES = `export interface Component<P> { (internal: unknown, props: P): unknown }
+export type ComponentProps<T> = T extends Component<infer P> ? P : never;
+`;
+
+/** A React component, `qr`, whose props extend the DOM's: only its own are params. */
+const QR_TYPES = `import type { CSSProperties, SVGProps } from "react";
+export interface QrProps extends SVGProps<SVGSVGElement> {
+  /** What the code holds */
+  value: string;
+  /**
+   * How much of it can be lost.
+   * @default "L"
+   */
+  level?: "L" | "M" | "Q" | "H";
+  bgColor?: CSSProperties["backgroundColor"];
+  size?: number;
+  title?: string | ((value: string) => string);
+  onDone?: () => void;
+  when?: Date;
+  tags?: string[];
+  options?: { margin: number };
+  label?: "on top" | "below";
+  any?: string | number;
+}
+declare const Qr: (props: QrProps) => unknown;
+export default Qr;
+`;
+
+/** The files of the four packages, and of React's and Svelte's types, under a pack's `node_modules`. */
+export const WRAPPED: Record<string, string | object> = {
+  "node_modules/react/package.json": { name: "react", version: "19.3.0", types: "index.d.ts" },
+  "node_modules/react/index.d.ts": REACT_TYPES,
+  "node_modules/svelte/package.json": { name: "svelte", version: "5.57.2", types: "index.d.ts" },
