+// A prop as a param (decision 6 of docs/wrapping-an-npm-package.md): each kind of type, what is left out and why, the
+// overrides, and inputs.
+import { describe, expect, it } from "vitest";
+import type { Wrap } from "./config.ts";
+import { defaultValue, mapProp } from "./map.ts";
+import type { Prop, PropType } from "./props.ts";
+
+const wrap: Wrap = { from: "qr", export: "default", kind: "react", params: [] };
+const prop = (name: string, type: PropType, more: Partial<Prop> = {}): Prop => ({ name, type, optional: true, ...more });
+
+describe("mapProp", () => {
+  it("maps each kind of type the spec has", () => {
+    const mapped = (type: PropType) => {
+      const param = mapProp(prop("p", type), wrap);
+      return "type" in param ? param.type : param.why;
+    };
+    expect(["string", "number", "boolean", "date", "array", "object", "color"].map((kind) => mapped({ kind } as PropType))).toEqual(["string", "number", "boolean", "date", "array", "object", "color"]);
+    expect(mapped({ kind: "literals", values: ["L", "M", "Q", "H"] })).toBe("L | M | Q | H");
+    expect(mapped({ kind: "literals", values: ["on top", "below"] })).toBe("string");
+  });
+
+  it("takes a union's one usable branch, saying so, and leaves out one with none or several", () => {
+    expect(mapProp(prop("title", { kind: "union", branches: [{ kind: "string" }, { kind: "function" }] }), wrap)).toMatchObject({ type: "string", note: "its string branch, of 2" });
+    expect(mapProp(prop("any", { kind: "union", branches: [{ kind: "string" }, { kind: "number" }] }), wrap)).toEqual({ prop: "any", why: "a union of string, number: name its type in `overrides`" });
+    expect(mapProp(prop("odd", { kind: "union", branches: [{ kind: "function" }, { kind: "other", text: "symbol" }] }), wrap)).toMatchObject({ why: "a union with no branch a param can be" });
+  });
+
+  it("leaves out callbacks, what the box takes, React's and the DOM's own, and a size in pixels", () => {
+    const why = (name: string, type: PropType = { kind: "string" }) => {
+      const mapped = mapProp(prop(name, type), wrap);
+      return "why" in mapped ? mapped.why : undefined;
+    };
+    expect(why("onDone", { kind: "function" })).toBe("a callback");
+    expect(why("height", { kind: "number" })).toMatch(/common param/);
+    expect(why("class")).toMatch(/common param/);
+    expect(why("style")).toBe("the box's to style");
+    expect(why("ref")).toBe("React's own");
+    expect(why("size", { kind: "number" })).toMatch(/a size in pixels/);
+    expect(why("size", { kind: "literals", values: ["s", "l"] })).toBeUndefined();
+    expect(why("symbol", { kind: "other", text: "symbol" })).toBe("its type, symbol, is no param's");
+  });
+
+  it("keeps a prop's doc, optional mark and JSDoc default, the overrides over them", () => {
+    const level = prop("level", { kind: "literals", values: ["L", "H"] }, { doc: "Loss", default: '"L"' });
+    expect(mapProp(level, wrap)).toEqual({ name: "level", prop: "level", type: "L | H", optional: true, default: "L", doc: "Loss" });
+    const overrides = { ...wrap, overrides: { fgColor: { name: "color", default: "black" }, x: { type: "string", doc: "The field" } } };
+    expect(mapProp(prop("fgColor", { kind: "color" }), overrides)).toEqual({ name: "color", prop: "fgColor", type: "color", optional: true, default: "black" });
+    expect(mapProp(prop("x", { kind: "function" }), overrides)).toMatchObject({ name: "x", type: "string", doc: "The field" });
+  });
+
+  it("makes an input of a prop the overrides name, with no default, and leaves out its callback and a slot's prop", () => {
+    const inputs = { ...wrap, input: { value: "onChange", tone: "onTone" }, slots: { default: "children" } };
+    expect(mapProp(prop("value", { kind: "string" }, { default: '"a"' }), inputs)).toEqual({ name: "value", prop: "value", type: "input<string>", optional: true });
+    expect(mapProp(prop("tone", { kind: "literals", values: ["a", "b"] }), inputs)).toMatchObject({ type: "input<enum>" });
+    expect(mapProp(prop("onChange", { kind: "function" }), inputs)).toEqual({ prop: "onChange", why: "reports the input `value`" });
+    expect(mapProp(prop("children", { kind: "object" }), inputs)).toEqual({ prop: "children", why: "the slot `default`" });
+    expect(mapProp(prop("children", { kind: "object" }), wrap)).toMatchObject({ why: /name it in `slots`/ });
+  });
+});
+
+describe("defaultValue", () => {
+  it("reads a default as JSON, a quoted string, or as written", () => {
+    expect(["256", "true", '"L"', "'M'", "`Q`", "[1, 2]", "auto"].map(defaultValue)).toEqual([256, true, "L", "M", "Q", [1, 2], "auto"]);
+  });
+});
diff --git a/npm-packages/pack/src/wrap/map.ts b/npm-packages/pack/src/wrap/map.ts
new file mode 100644
index 0000000..35c2c83
--- /dev/null
+++ b/npm-packages/pack/src/wrap/map.ts
@@ -0,0 +1,124 @@
+// A prop as a param (docs/wrapping-an-npm-package.md, decision 6, spec §7.3): its type in the spec's grammar, optional
+// or with its JSDoc default, the author's overrides over it (decision 7); or why it isn't one, which the build lists.
+
+import { BOX_PARAMS } from "@compmd/render";
+import type { Override, Wrap } from "./config.ts";
+import type { Prop, PropType } from "./props.ts";
+
+/** A param of the generated signature. */
+export interface Param {
+  /** Its name in the signature: the prop's, or the override's. */
+  name: string;
+  /** The prop it is given to. */
+  prop: string;
+  /** Its type in the spec's grammar, without `?`. */
+  type: string;
+  optional: boolean;
+  default?: unknown;
+  doc?: string;
+  /** What the build says of how it mapped: the branch of a union it took. */
+  note?: string;
+}
+
+/** A prop that isn't a param, and why. */
+export interface Left {
+  prop: string;
+  why: string;
+}
+
+/** An enum member: a name of the spec's grammar (§3.1). */
+const NAME = /^[A-Za-z][A-Za-z0-9_-]*$/;
+
+/** Props no document gives: React's and the DOM's own, and what a box or a slot gives instead. */
+const NEVER: Record<string, string> = {
+  ref: "React's own",
+  key: "React's own",
+  style: "the box's to style",
+  className: "the box's to style",
+  children: "content, not a value: name it in `slots` to make it one",
+};
+
+type Mapped = { type: string; note?: string } | { why: string };
+
+function mappedType(type: PropType): Mapped {
+  switch (type.kind) {
+    case "string":
+    case "number":
+    case "boolean":
+    case "date":
+    case "array":
+    case "object":
+    case "color":
+      return { type: type.kind };
+    case "literals":
+      return type.values.every((value) => NAME.test(value)) ? { type: type.values.join(" | ") } : { type: "string", note: "its values aren't names, so it is a string" };
+    case "function":
+      return { why: "a callback" };
+    case "union": {
+      const usable = [...new Set(type.branches.map(mappedType).flatMap((mapped) => ("type" in mapped ? [mapped.type] : [])))];
+      const [only] = usable;
+      if (usable.length === 1 && only !== undefined) return { type: only, note: `its ${only} branch, of ${String(type.branches.length)}` };
+      return { why: usable.length === 0 ? "a union with no branch a param can be" : `a union of ${usable.join(", ")}: name its type in \`overrides\`` };
+    }
+    case "other":
+      return { why: `its type, ${type.text}, is no param's` };
+  }
+}
+
+/** A JSDoc `@default` as a value: JSON, or a quoted string, else as written. */
+export function defaultValue(written: string): unknown {
+  try {
+    return JSON.parse(written);
+  } catch {
+    const quoted = /^(['"`])(.*)\1$/.exec(written);
+    return quoted ? quoted[2] : written;
+  }
+}
+
+/** `param` with `override` over it. */
+function overridden(param: Param, override: Override | undefined): Param {
+  if (!override) return param;
+  return {
+    ...param,
+    ...(override.name === undefined ? {} : { name: override.name }),
+    ...(override.type === undefined ? {} : { type: override.type }),
+    ...(override.default === undefined ? {} : { default: override.default }),
+    ...(override.doc === undefined ? {} : { doc: override.doc }),
+  };
+}
+
+/**
+ * `prop` as a param of the signature `wrap` generates, or why it isn't one.
+ *
+ * @example
+ * mapProp({ name: "level", type: { kind: "literals", values: ["L", "M"] }, optional: true }, wrap);
+ * // { name: "level", prop: "level", type: "L | M", optional: true }
+ */
+export function mapProp(prop: Prop, wrap: Wrap): Param | Left {
+  const slot = Object.entries(wrap.slots ?? {}).find(([, given]) => given === prop.name)?.[0];
+  if (slot !== undefined) return { prop: prop.name, why: `the slot \`${slot}\`` };
+  const reported = Object.entries(wrap.input ?? {}).find(([, callback]) => callback === prop.name)?.[0];
+  if (reported !== undefined) return { prop: prop.name, why: `reports the input \`${reported}\`` };
+  const never = NEVER[prop.name];
+  if (never !== undefined) return { prop: prop.name, why: never };
+  if (BOX_PARAMS.has(prop.name)) return { prop: prop.name, why: "named like a common param: the use's box takes it, and the component fits its box" };
+  if (prop.name === "size" && prop.type.kind === "number") return { prop: prop.name, why: "a size in pixels: the component fits its box, which the use sizes" };
+  const override = wrap.overrides?.[prop.name];
+  const mapped = override?.type === undefined ? mappedType(prop.type) : { type: override.type };
+  if ("why" in mapped) return { prop: prop.name, why: mapped.why };
+  const input = wrap.input?.[prop.name] !== undefined;
+  const type = input ? `input<${mapped.type.includes("|") ? "enum" : mapped.type}>` : mapped.type;
+  const param: Param = {
+    name: prop.name,
+    prop: prop.name,
+    type,
+    optional: prop.optional,
+    ...(prop.default === undefined || input ? {} : { default: defaultValue(prop.default) }),
+    ...(prop.doc === undefined ? {} : { doc: prop.doc }),
+    ...(mapped.note === undefined ? {} : { note: mapped.note }),
+  };
+  return overridden(param, override);
+}
+
+/** Whether `mapped` is a param. */
+export const isParam = (mapped: Param | Left): mapped is Param => "type" in mapped;
