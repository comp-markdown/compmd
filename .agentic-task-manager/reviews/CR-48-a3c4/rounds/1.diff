index 0000000..30ad4d7
--- /dev/null
+++ b/compmd-packs/rating/src/rating.test.ts
@@ -0,0 +1,65 @@
+import { mountForTest } from "@compmd/pack/testing";
+import { describe, expect, it } from "vitest";
+import mount, { MOST, starsOf } from "./rating.ts";
+
+/** The drawing, its label, how many stars it has and how wide its filled part is, in stars. */
+function drawn(target: Element) {
+  const drawing = target.querySelector("svg");
+  return {
+    label: drawing?.getAttribute("aria-label"),
+    role: drawing?.getAttribute("role"),
+    stars: drawing?.querySelectorAll("g[fill-opacity] path").length,
+    filled: Number(drawing?.querySelector("clipPath rect")?.getAttribute("width")) / 24,
+    viewBox: drawing?.getAttribute("viewBox"),
+  };
+}
+
+describe("rating", () => {
+  it("draws `of` stars, `value` of them filled, labelled by the fallback", () => {
+    const shown = mountForTest(mount, { params: { value: 4, of: 5 }, fallback: "Four of five stars" });
+    expect(drawn(shown.target)).toEqual({ label: "Four of five stars", role: "img", stars: 5, filled: 4, viewBox: "0 0 120 24" });
+    shown.destroy();
+    expect(shown.target.childElementCount).toBe(0);
+  });
+
+  it("says “Rated 3.5 of 10” with no fallback, and follows new params", () => {
+    const shown = mountForTest(mount, { params: { value: 3.5, of: 10 }, fallback: "" });
+    expect(drawn(shown.target)).toMatchObject({ label: "Rated 3.5 of 10", stars: 10, filled: 3.5 });
+    shown.update({ value: 2, of: 5 });
+    expect(drawn(shown.target)).toMatchObject({ label: "Rated 2 of 5", stars: 5, filled: 2 });
+    shown.destroy();
+  });
+
+  it("fits its box as the document says", () => {
+    const shown = mountForTest(mount, { params: { value: 1, of: 5 } });
+    expect(shown.target.querySelector("svg")?.getAttribute("preserveAspectRatio")).toBe("xMidYMid meet");
+    shown.setFit({ mode: "contain", x: 0, y: 0.5 });
+    expect(shown.target.querySelector("svg")?.getAttribute("preserveAspectRatio")).toBe("xMinYMid meet");
+    shown.destroy();
+  });
+
+  it("gives each rating on a page its own clip", () => {
+    const [a, b] = [mountForTest(mount, { params: { value: 1, of: 5 } }), mountForTest(mount, { params: { value: 2, of: 5 } })];
+    const id = (target: Element) => target.querySelector("clipPath")?.id;
+    expect(id(a.target)).not.toBe(id(b.target));
+    a.destroy();
+    b.destroy();
+  });
+});
+
+describe("starsOf", () => {
+  it("rounds the value to the nearest half, between 0 and `of`, and keeps `of` a whole number from 1 to the most", () => {
+    expect([starsOf({ value: 3.3, of: 5 }), starsOf({ value: 3.8, of: 5 }), starsOf({ value: -1, of: 5 }), starsOf({ value: 9, of: 5 })]).toEqual([
+      { value: 3.5, of: 5 },
+      { value: 4, of: 5 },
+      { value: 0, of: 5 },
+      { value: 5, of: 5 },
+    ]);
+    expect([starsOf({ value: 1, of: 0 }), starsOf({ value: 1, of: 3.6 }), starsOf({ value: 1, of: 500 }), starsOf({ value: Number.NaN, of: Number.NaN })]).toEqual([
+      { value: 1, of: 1 },
+      { value: 1, of: 4 },
+      { value: 1, of: MOST },
+      { value: 0, of: 5 },
+    ]);
+  });
+});
diff --git a/compmd-packs/rating/src/rating.ts b/compmd-packs/rating/src/rating.ts
new file mode 100644
index 0000000..a474c7e
--- /dev/null
+++ b/compmd-packs/rating/src/rating.ts
@@ -0,0 +1,67 @@
+// `rating`: `value` of `of` stars, half stars included, read-only, drawn as one SVG that fits its box. The filled stars
+// are clipped to the value's width over the empty ones, so 3.5 shows three and a half. Its text alternative is the
+// use's fallback, "Rated 4 of 5" when it has none; it prints as drawn.
+import { component, fitBox } from "@compmd/pack/component";
+
+/** The params, as the signature in `index.comp.md` declares them. */
+export interface Params {
+  value: number;
+  of: number;
+}
+
+const SVG = "http://www.w3.org/2000/svg";
+/** A star, 24 units across. */
+const STAR = "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z";
+const SIZE = 24;
+/** The most stars a rating draws: a larger `of` is drawn as this many. */
+export const MOST = 20;
+
+/** An SVG element with `attributes`. */
+function svg(name: string, attributes: Record<string, string>): SVGElement {
+  const element = document.createElementNS(SVG, name);
+  for (const [key, value] of Object.entries(attributes)) element.setAttribute(key, value);
+  return element;
+}
+
+/** `of`, a whole number of stars from 1 to `MOST`, and `value`, between 0 and it, to the nearest half. */
+export function starsOf({ value, of }: Params): { value: number; of: number } {
+  const stars = Math.min(MOST, Math.max(1, Math.round(Number.isFinite(of) ? of : 5)));
+  const shown = Math.round(Math.min(stars, Math.max(0, Number.isFinite(value) ? value : 0)) * 2) / 2;
+  return { value: shown, of: stars };
+}
+
+/** The number as a reader says it: `4`, `3.5`. */
+const said = (n: number): string => (Number.isInteger(n) ? String(n) : n.toFixed(1));
+
+/** Each mount's own clip id, as several ratings share a document. */
+let mounted = 0;
+
+export default component<Params>((target, context) => {
+  const clip = `compmd-rating-${String((mounted += 1))}`;
+  const drawing = svg("svg", { role: "img" });
+  const shape = svg("clipPath", { id: clip });
+  const width = svg("rect", { x: "0", y: "0", height: String(SIZE) });
+  shape.append(width);
+  const empty = svg("g", { fill: "currentColor", "fill-opacity": "0.25" });
+  const filled = svg("g", { fill: "var(--compmd-accent, #e0a100)", "clip-path": `url(#${clip})` });
+  drawing.append(svg("defs", {}), empty, filled);
+  drawing.firstElementChild?.append(shape);
+  target.append(drawing);
+  const draw = (params: Params) => {
+    const { value, of } = starsOf(params);
+    drawing.setAttribute("viewBox", `0 0 ${String(of * SIZE)} ${String(SIZE)}`);
+    drawing.setAttribute("aria-label", context.fallback.text || `Rated ${said(value)} of ${String(of)}`);
+    width.setAttribute("width", String(value * SIZE));
+    const stars = Array.from({ length: of }, (_, i) => svg("path", { d: STAR, transform: `translate(${String(i * SIZE)} 0)` }));
+    empty.replaceChildren(...stars.map((star) => star.cloneNode()));
+    filled.replaceChildren(...stars);
+    fitBox(drawing, context.fit);
+  };
+  draw(context.params);
+  return {
+    update: draw,
+    destroy: () => {
+      drawing.remove();
+    },
+  };
+});
diff --git a/compmd-packs/rating/test/page.test.ts b/compmd-packs/rating/test/page.test.ts
new file mode 100644
index 0000000..7abe9a3
--- /dev/null
+++ b/compmd-packs/rating/test/page.test.ts
@@ -0,0 +1,103 @@
+// The test page `compmd-pack dev` serves (`demo.comp.md`), as a host renders it: in host mode, each rating in a strict
+// frame of its own with the pack's built module loaded by URL, in Chrome and WebKit. Every example's stars draw, with
+// their label as the text alternative and their value filled; inline ones sit in their sentence; they print as drawn;
+// and the strict policy refuses nothing.
+import { join } from "node:path";
+import { readPack, servePack } from "@compmd/pack";
+import { chromium, webkit, type Browser, type BrowserType, type Frame, type LaunchOptions, type Page } from "playwright";
+import type { ViteDevServer } from "vite";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+
+const ROOT = join(import.meta.dirname, "..");
+const PORT = 4223;
+
+const BROWSERS: [string, BrowserType, LaunchOptions][] = [
+  ["Chrome", chromium, { channel: "chrome" }],
+  ["WebKit", webkit, {}],
+];
+
+/** Each example's label, and the stars it fills of how many. */
+const RATINGS: [label: string, filled: number, of: number][] = [
+  ["Four of five stars", 4, 5],
+  ["Three and a half of five", 3.5, 5],
+  ["Seven of ten", 7, 10],
+  ["two of five", 2, 5],
+  ["five of five", 5, 5],
+];
+
+let server: ViteDevServer;
+
+beforeAll(async () => {
+  server = await servePack(await readPack(ROOT), { port: PORT });
+}, 120_000);
+
+afterAll(async () => {
+  await server.close();
+});
+
+const drawing = (label: string) => `svg[role="img"][aria-label="${label}"]`;
+
+/** The frame that draws the rating labelled `label`, once one does. */
+async function frameWith(page: Page, label: string): Promise<Frame> {
+  let found: Frame | undefined;
+  await expect
+    .poll(
+      async () => {
+        for (const frame of page.frames()) if ((await frame.locator(drawing(label)).count().catch(() => 0)) > 0) found = frame;
+        return found !== undefined;
+      },
+      { timeout: 30_000 },
+    )
+    .toBe(true);
+  return found as Frame;
+}
+
+describe.each(BROWSERS)("the test page in %s", (_name, type, options) => {
+  let browser: Browser;
+  let page: Page;
+  const problems: string[] = [];
+
+  beforeAll(async () => {
+    browser = await type.launch({ headless: true, ...options });
+    page = await browser.newPage();
+    page.on("pageerror", (error) => problems.push(error.message));
+    page.on("console", (message) => {
+      if (/Content.Security.Policy|Refused to/i.test(message.text())) problems.push(message.text());
+    });
+    await page.goto(`http://localhost:${String(PORT)}/`);
+  }, 60_000);
+
+  afterAll(async () => {
+    await browser.close();
+  });
+
+  it("draws every example's stars, each labelled, its value filled, with nothing refused or reported", async () => {
+    for (const [label, filled, of] of RATINGS) {
+      const frame = await frameWith(page, label);
+      const stars = frame.locator(drawing(label));
+      expect(await stars.locator("g[fill-opacity] path").count(), label).toBe(of);
+      expect(Number(await stars.locator("clipPath rect").getAttribute("width")) / 24, label).toBe(filled);
+      expect((await stars.boundingBox())?.width ?? 0, label).toBeGreaterThan(0);
+    }
+    expect(await page.locator("#diagnostics li").allInnerTexts()).toEqual([]);
+    expect(problems).toEqual([]);
+  }, 60_000);
+
+  it("sits an inline rating in its sentence, as high as the text around it", async () => {
+    await frameWith(page, "two of five");
+    const frame = page.locator('iframe[title="rating"]').nth(3);
+    const box = await frame.boundingBox();
+    const line = await page.locator("p", { hasText: "The cheese was" }).boundingBox();
+    expect(box && line && box.y >= line.y - 1 && box.y + box.height <= line.y + line.height + 1).toBe(true);
+  }, 60_000);
+
+  it("prints its stars as drawn", async () => {
+    await page.emulateMedia({ media: "print" });
+    try {
+      const frame = await frameWith(page, "Four of five stars");
+      expect((await frame.locator(drawing("Four of five stars")).boundingBox())?.width ?? 0).toBeGreaterThan(0);
+    } finally {
+      await page.emulateMedia({ media: "screen" });
+    }
+  }, 60_000);
+});
