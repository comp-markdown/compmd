{
  // The type check of the repository's own tools, here and in `../spec-revision/` (audit B27): `cargo make scripts`
  // runs it. Node runs them as they are, its types stripped, so only erasable syntax is allowed (the base's).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node"]
  },
  "include": ["*.ts", "../spec-revision/*.ts"]
}
