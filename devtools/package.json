{
  "name": "@compmd/devtools",
  "version": "0.2.2",
  "private": true,
  "description": "The CompMD Developer Tools as a part any page embeds: a document's text and its page side by side, the views of what the processor makes of it, and what its sandbox does: its frames, a console and the messages between them.",
  "keywords": [
    "compmd",
    "markdown",
    "components",
    "devtools",
    "editor"
  ],
  "homepage": "https://compmd.hakanserce.com/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "devtools"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts && tsc -p tsconfig.build.json",
    "lint": "eslint . && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output machine",
    "test": "vitest run"
  },
  "dependencies": {
    "@compmd/processor": "workspace:^",
    "@compmd/registry": "workspace:^",
    "@compmd/render": "workspace:^",
    "@compmd/sandbox": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "happy-dom": "21.0.3",
    "rolldown": "1.2.15",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
