{
  "name": "@compmd/vite",
  "version": "0.2.2",
  "description": "A Vite plugin for CompMD: reads compmd.config.json, gives the processor the app's packs, serves the sandbox and the packs' files, and bundles the app's own trusted components.",
  "keywords": [
    "compmd",
    "markdown",
    "components",
    "vite",
    "vite-plugin",
    "sandbox"
  ],
  "homepage": "https://compmd.hakanserce.com/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "vite"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "client.d.ts",
    "compmd.config.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./compmd.config.schema.json": "./compmd.config.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@compmd/processor": "workspace:^",
    "@compmd/registry": "workspace:^",
    "@compmd/render": "workspace:^",
    "@compmd/sandbox": "workspace:^",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "svelte": "^5",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svelte": "5.57.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
