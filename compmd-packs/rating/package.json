{
  "name": "@comp-markdown/rating",
  "version": "0.1.0",
  "description": "A CompMD pack: rating, a value as stars, half stars included, read-only, drawn as SVG in the host's strict sandbox.",
  "keywords": ["compmd", "compmd-pack", "rating", "stars"],
  "homepage": "https://compmd.dev/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "compmd-packs/rating"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "compmd": "./index.comp.md",
  "files": ["dist", "index.comp.md", "README.md"],
  "scripts": {
    "build": "compmd-pack build",
    "dev": "compmd-pack dev",
    "test": "compmd-pack build && compmd-pack test && vitest run --dir test",
    "lint": "tsc --noEmit",
    "prepublishOnly": "compmd-pack build && compmd-pack test"
  },
  "devDependencies": {
    "@compmd/pack": "workspace:*",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
