{
  "name": "@comp-markdown/gallery",
  "version": "0.1.0",
  "description": "A CompMD pack: gallery, a grid of cards, one for each item of a list, each with its image, title and description. A compmd definition, with no code.",
  "keywords": ["compmd", "compmd-pack", "gallery"],
  "homepage": "https://compmd.dev/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "compmd-packs/gallery"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "compmd": "./index.comp.md",
  "files": ["index.comp.md", "README.md"],
  "scripts": {
    "build": "compmd-pack build",
    "dev": "compmd-pack dev",
    "test": "compmd-pack build && vitest run --dir test",
    "lint": "tsc --noEmit",
    "prepublishOnly": "compmd-pack build"
  },
  "dependencies": {
    "@comp-markdown/card": "workspace:^"
  },
  "devDependencies": {
    "@compmd/pack": "workspace:*",
    "@compmd/processor": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
