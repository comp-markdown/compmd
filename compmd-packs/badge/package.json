{
  "name": "@comp-markdown/badge",
  "version": "0.1.0",
  "description": "A CompMD pack: badge, a word or two in a sentence in a small tinted box, \"new\", \"beta\", a version. A compmd definition, with no code.",
  "keywords": ["compmd", "compmd-pack", "badge"],
  "homepage": "https://compmd.dev/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "compmd-packs/badge"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "compmd": "./index.comp.md",
  "files": ["index.comp.md", "README.md"],
  "scripts": {
    "build": "compmd-pack build",
    "dev": "compmd-pack dev",
    "test": "compmd-pack build && vitest run --dir test",
    "lint": "eslint . && tsc --noEmit",
    "prepublishOnly": "compmd-pack build"
  },
  "devDependencies": {
    "@compmd/pack": "workspace:*",
    "@compmd/processor": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
