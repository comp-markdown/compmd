{
  "name": "@comp-markdown/sticky-note",
  "version": "0.2.0",
  "description": "A CompMD pack: sticky-note, a yellow note pinned on the page, tilted, with a corner turned up and a shadow, placed with inset-* where it should sit. A compmd definition, with no code.",
  "keywords": ["compmd", "compmd-pack", "note", "sticky-note"],
  "homepage": "https://compmd.dev/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "compmd-packs/sticky-note"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "compmd": "./index.comp.md",
  "files": ["index.comp.md", "README.md"],
  "scripts": {
    "build": "compmd-pack build",
    "dev": "compmd-pack dev",
    "test": "compmd-pack build && vitest run --dir test",
    "lint": "tsc --noEmit",
    "prepublishOnly": "compmd-pack build"
  },
  "devDependencies": {
    "@compmd/pack": "workspace:*",
    "@compmd/processor": "workspace:*",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
