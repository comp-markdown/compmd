{
  "name": "@comp-markdown/columns",
  "version": "0.1.0",
  "description": "A CompMD pack: columns, two or three columns side by side, one of them wider by split, stacking on a phone. A compmd definition, with no code.",
  "keywords": ["compmd", "compmd-pack", "columns", "layout"],
  "homepage": "https://compmd.dev/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "compmd-packs/columns"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "compmd": "./index.comp.md",
  "files": ["index.comp.md", "README.md"],
  "scripts": {
    "build": "compmd-pack build",
    "dev": "compmd-pack dev",
    "test": "compmd-pack build && vitest run --dir test",
    "lint": "eslint . && tsc --noEmit",
    "prepublishOnly": "compmd-pack build"
  },
  "devDependencies": {
    "@compmd/pack": "workspace:*",
    "@compmd/processor": "workspace:*",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
