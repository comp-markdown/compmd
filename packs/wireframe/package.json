  "description": "A CompMD pack that draws wireframes from ```wireframe blocks, as HTML and CSS, in the host's strict sandbox.",
  "keywords": ["compmd", "compmd-pack", "wireframe", "mockup"],
  "homepage": "https://compmd.dev/",
  "bugs": "https://github.com/comp-markdown/compmd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-markdown/compmd.git",
    "directory": "packs/wireframe"
  },
  "author": "Hakan Serce",
  "license": "MIT",
  "type": "module",
  "compmd": "./index.comp.md",
  "files": ["dist", "index.comp.md", "README.md"],
  "scripts": {
    "build": "compmd-pack build",
    "dev": "compmd-pack dev",
    "test": "compmd-pack test",
    "lint": "tsc --noEmit",
